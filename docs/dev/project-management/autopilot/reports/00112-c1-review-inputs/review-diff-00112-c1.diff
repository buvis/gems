lf.running = False\n40:         self.events.append((\"stop\", self.current))\n41: \n42:     def update(self, message: Text, **kwargs: object) -> None:\n43:         assert isinstance(message, Text)\n44:         self.current = message.plain\n45:         self.events.append((\"update\", self.current))\n46:         if self.interrupt:\n47:             self.interrupt = False\n48:             raise KeyboardInterrupt\n49: \n50: \n51: @pytest.fixture\n52: def cli_display(monkeypatch: pytest.MonkeyPatch) -> tuple[StatusRecorder, StringIO]:\n53:     stream = StringIO()\n54:     monkeypatch.setattr(console, \"console\", Console(file=stream, width=240, color_system=None))\n55:     recorder = StatusRecorder()\n56:     monkeypatch.setattr(console, \"status\", recorder.status)\n57:     monkeypatch.setattr(sys.stdout, \"isatty\", lambda: True)\n58:     return recorder, stream\n59: \n60: \n61: class ControlledCapability:\n62:     inputs: dict[str, object] = {}\n63: \n64:     def __init__(self, results: dict[str, StepResult], *, progress: bool = True) -> None:\n65:         self.results = results\n66:         self.progress = progress\n67:         self.closed: list[str] = []\n68: \n69:     def plan(self, **kwargs: object) -> PlanEntry:\n70:         label = str(kwargs[\"label\"])\n71:         return PlanEntry(label, f\"/source/{label}\", f\"/out/{label}.tar.gz\", \"run\", \"\", False)\n72: \n73:     def run(self, **kwargs: object) -> Iterator[StepResult]:\n74:         label = str(kwargs[\"label\"])\n75:         try:\n76:             callback = kwargs.get(\"progress\")\n77:             if self.progress and callable(callback):\n78:                 callback(ProgressEvent(label, \"archiving\", 7, 19))\n79:                 callback(ProgressEvent(label, \"finalizing\", 19, 19))\n80:             yield self.results[label]\n81:         finally:\n82:             self.closed.append(label)\n83: \n84: \n85: def controlled_plan(\n86:     monkeypatch: pytest.MonkeyPatch,\n87:     results: list[StepResul