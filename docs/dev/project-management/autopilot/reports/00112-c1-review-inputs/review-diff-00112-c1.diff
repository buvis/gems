isinstance(message, Text)\n        self.current = message.plain\n        self.events.append((\"update\", self.current))\n        if self.interrupt:\n            self.interrupt = False\n            raise KeyboardInterrupt\n\n\n@pytest.fixture\ndef cli_display(monkeypatch: pytest.MonkeyPatch) -> tuple[StatusRecorder, StringIO]:\n    stream = StringIO()\n    monkeypatch.setattr(console, \"console\", Console(file=stream, width=240, color_system=None))\n    recorder = StatusRecorder()\n    monkeypatch.setattr(console, \"status\", recorder.status)\n    monkeypatch.setattr(sys.stdout, \"isatty\", lambda: True)\n    return recorder, stream\n\n\nclass ControlledCapability:\n    inputs: dict[str, object] = {}\n\n    def __init__(self, results: dict[str, StepResult], *, progress: bool = True) -> None:\n        self.results = results\n        self.progress = progress\n        self.closed: list[str] = []\n\n    def plan(self, **kwargs: object) -> PlanEntry:\n        label = str(kwargs[\"label\"])\n        return PlanEntry(label, f\"/source/{label}\", f\"/out/{label}.tar.gz\", \"run\", \"\", False)\n\n    def run(self, **kwargs: object) -> Iterator[StepResult]:\n        label = str(kwargs[\"label\"])\n        try:\n            callback = kwargs.get(\"progress\")\n            if self.progress and callable(callback):\n                callback(ProgressEvent(label, \"archiving\", 7, 19))\n                callback(ProgressEvent(label, \"finalizing\", 19, 19))\n            yield self.results[label]\n        finally:\n            self.closed.append(label)\n\n\ndef controlled_plan(\n    monkeypatch: pytest.MonkeyPatch,\n    results: list[StepResult],\n    *,\n    progress: bool = True,\n) -> tuple[BackupConfig, list[tuple[str, BackupInstance]], ControlledCapability]:\n    capability = ControlledCapability({result.label: result for result in results}, progress=progress)\n    monkeypatch.setitem(CAPABILITIES, \"cli-progress-fixture\", capability)\n    instances = {result.label: BackupInstance(use=\"cli-progress-fixture\") for result in results}\n    return BackupConfig(instances=instances), list(instances.items()), capability\n\n\ndef result_lines() -> list[StepResult]:\n    return [\n        StepResult(\"docs\", True, \"first archive ready\"),\n        StepResult(\"docs-old\", False, \"second archive denied\"),\n        StepResult(\"optional\", True, \"optional source absent\", skipped=True),\n    ]\n\n\nclass TestCliProgressFormat:\n    @pytest.mark.parametrize(\n        \"event,elapsed,expected\",\n        [\n            (ProgressEvent(\"docs\", \"archiving\", 37, 100), 65.9, \"docs archiving [37%] 1:05\"),\n            (ProgressEvent(\"docs-old\", \"archiving\", 7, 19), 9.9, \"docs-old archiving [36%] 0:09\"),\n            (ProgressEvent(\"docs\", \"archiving\", 100, 100), 3605, \"docs archiving [99%] 60:05\"),\n            (ProgressEvent(\"docs-old\", \"archiving\", 200, 100), -3, \"docs-old archiving [99%] 0:00\"),\n            (ProgressEvent(\"git\", \"scanning\", None, None), 2, \"git scanning 0:02\"),\n            (ProgressEvent(\"git-old\", \"archiving\", None, 700), 120, \"git-old archiving 2:00\"),\n            (ProgressEvent(\"git\", \"archiving\", 7, None), 61, \"git archiving 1:01\"),\n            (ProgressEvent(\"git-old\", \"archiving\", 0, 0), 59, \"git-old archiving 0:59\"),\n            (ProgressEvent(\"git\", \"archiving\", 0, -1), 0, \"git archiving 0:00\"),\n            (ProgressEvent(\"git\", \"finalizing\", 7, 19), 120, \"git finalizing 2:00\"),\n            (ProgressEvent(\"git-old\", \"finalizing\", 100, 100), 3661, \"git-old finalizing 61:01\"),\n            (ProgressEvent(\"\", \"scanning\", None, None), -0.5, \" scanning 0:00\"),\n        ],\n    )\n    def test_format_uses_input_byte_floor_caps_and_unbounded_minutes(\n        self,\n        event: ProgressEvent,\n        elapsed: float,\n        expected: str,\n    ) -> None:\n        assert backup_cli._format_progress(event, elapsed) == expected\n\n    @pytest.mark.parametrize(\n        \"done,total,percent\",\n        [(25, 100, 25), (1, 3, 33), (2, 7, 28), (13, 29, 44), (47, 64, 73), (1001, 4096, 24)],\n    )\n    def test_format_percentage_handles_varied_byte_ratios(self, done: int, total: int, percent: int) -> None:\n        event = ProgressEvent(\"arbitrary\", \"archiving\", done, total)\n        assert backup_cli._format_progress(event, 65) == f\"arbitrary archiving [{percent}%] 1:05\"\n\n\nclass TestCliLiveProgress:\n    def test_cli_three_active_labels_preserve_order_and_elapsed_across_phase_changes(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n        monkeypatch: pytest.MonkeyPatch,\n    ) -> None:\n        recorder, _ = cli_display\n        clock = [100.0]\n        monkeypatch.setattr(time, \"monotonic\", lambda: clock[0])\n        live = backup_cli._LiveProgress()\n        try:\n            live.on_progress(ProgressEvent(\"docs\", \"scanning\", None, None))\n            clock[0] = 130.0\n            live.on_progress(ProgressEvent(\"docs-old\", \"scanning\", None, None))\n            clock[0] = 160.0\n            live.on_progress(ProgressEvent(\"photos\", \"scanning\", None, None))\n            clock[0] = 165.0\n            live.on_progress(ProgressEvent(\"docs\", \"archiving\", 25, 100))\n            assert recorder.current == (\"docs archiving [25%] 1:05 | docs-old scanning 0:35 | photos scanning 0:05\")\n        finally:\n            live.close()\n\n    def test_cli_status_preserves_first_seen_time_order_and_exact_labels(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n        monkeypatch: pytest.MonkeyPatch,\n    ) -> None:\n        recorder, _ = cli_display\n        clock = [100.0]\n        monkeypatch.setattr(time, \"monotonic\", lambda: clock[0])\n        live = backup_cli._LiveProgress()\n        live.refresh()\n        live.finish(\"docs\")\n        assert recorder.created == []\n        live.on_progress(ProgressEvent(\"[red]docs\", \"scanning\", None, None))\n        clock[0] = 165.0\n        live.on_progress(ProgressEvent(\"[red]docs-old\", \"archiving\", 7, 19))\n        clock[0] = 170.0\n        live.on_progress(ProgressEvent(\"[red]docs\", \"finalizing\", 19, 19))\n        assert recorder.current == \"[red]docs finalizing 1:10 | [red]docs-old archiving [36%] 0:05\"\n        live.finish(\"docs\")\n        assert recorder.current.startswith(\"[red]docs finalizing 1:10 | \")\n        live.finish(\"[red]docs\")\n        assert recorder.current == \"[red]docs-old archiving [36%] 0:05\"\n        live.finish(\"[red]docs\")\n        assert recorder.running is True\n        live.finish(\"[red]docs-old\")\n        assert recorder.running is False\n        clock[0] = 180.0\n        live.on_progress(ProgressEvent(\"[red]docs\", \"archiving\", 3, 7))\n        assert recorder.current == \"[red]docs archiving [42%] 0:00\"\n        live.close()\n        live.close()\n        assert recorder.created == [\"\"]\n        assert [name for name, _ in recorder.events].count(\"start\") == 2\n        assert [name for name, _ in recorder.events].count(\"stop\") == 2\n\n    def test_cli_real_rich_status_restarts_after_all_labels_finish(\n        self,\n        monkeypatch: pytest.MonkeyPatch,\n    ) -> None:\n        stream = StringIO()\n        monkeypatch.setattr(console, \"console\", Console(file=stream, force_terminal=True, width=160))\n        statuses: list[object] = []\n        factory = console.status\n\n        def capture_status(message: str) -> object:\n            status = factory(message)\n            statuses.append(status)\n            return status\n\n        monkeypatch.setattr(console, \"status\", capture_status)\n        live = backup_cli._LiveProgress()\n        try:\n            live.on_progress(ProgressEvent(\"[red]docs\", \"archiving\", 7, 19))\n            live.finish(\"[red]docs\")\n            live.on_progress(ProgressEvent(\"[red]docs-old\", \"finalizing\", 19, 19))\n            live.finish(\"[red]docs-old\")\n        finally:\n            live.close()\n        output = stream.getvalue()\n        assert len(statuses) == 1\n        assert \"[red]docs archiving [36%]\" in output\n        assert \"[red]docs-old finalizing\" in output\n\n    def test_cli_interrupted_status_update_propagates_and_close_stops_spinner(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n    ) -> None:\n        recorder, _ = cli_display\n        live = backup_cli._LiveProgress()\n        live.on_progress(ProgressEvent(\"docs\", \"scanning\", None, None))\n        recorder.interrupt = True\n        try:\n            with pytest.raises(KeyboardInterrupt):\n                live.on_progress(ProgressEvent(\"docs-old\", \"archiving\", 7, 19))\n        finally:\n            live.close()\n        assert recorder.running is False\n        assert \"docs-old archiving [36%]\" in recorder.current\n\n\nclass TestCliProgressRunPlan:\n    @pytest.mark.parametrize(\"dry_run,verb\", [(False, \"archived\"), (True, \"previewed\")])\n    def test_cli_report_summary_counts_each_outcome_and_describes_dry_run(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n        dry_run: bool,\n        verb: str,\n    ) -> None:\n        _, stream = cli_display\n        assert backup_cli._report_steps(result_lines(), dry_run=dry_run) is True\n        assert stream.getvalue().splitlines()[-1].endswith(f\"{verb} 1, skipped 1, failed 1\")\n\n    @pytest.mark.parametrize(\n        \"result,marker\",\n        [\n            (StepResult(\"docs\", True, \"first archive ready\"), \"✔\"),\n            (StepResult(\"optional\", True, \"optional source absent\", skipped=True), \"⚠\"),\n            (StepResult(\"docs-old\", False, \"second archive denied\"), \"✘\"),\n        ],\n    )\n    def test_cli_result_output_uses_the_outcome_severity(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n        result: StepResult,\n        marker: str,\n    ) -> None:\n        _, stream = cli_display\n        backup_cli._report_steps([result])\n        lines = [line for line in stream.getvalue().splitlines() if result.message in line]\n        assert len(lines) == 1\n        assert lines[0].lstrip().startswith(marker)\n        assert result.message in lines[0]\n\n    def test_cli_skipped_success_keeps_success_exit_and_skip_count(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n    ) -> None:\n        _, stream = cli_display\n        result = StepResult(\"optional\", True, \"optional source absent\", skipped=True)\n        assert backup_cli._report_steps([result]) is False\n        assert stream.getvalue().splitlines()[-1].endswith(\"archived 0, skipped 1, failed 0\")\n\n    def test_cli_live_runner_tick_refreshes_elapsed_without_new_progress(\n        self,\n        monkeypatch: pytest.MonkeyPatch,\n        cli_display: tuple[StatusRecorder, StringIO],\n    ) -> None:\n        recorder, _ = cli_display\n        cfg, plan, capability = controlled_plan(monkeypatch, [StepResult(\"docs\", True, \"ready\")], progress=False)\n        clock = [100.0]\n        monkeypatch.setattr(time, \"monotonic\", lambda: clock[0])\n        refreshed: list[str] = []\n        original = Runner.__init__\n\n        def initialize(runner: Runner, *args: object, **kwargs: object) -> None:\n            original(runner, *args, **kwargs)\n            progress, tick = kwargs.get(\"on_progress\"), kwargs.get(\"on_tick\")\n            assert callable(progress)\n            assert callable(tick)\n            progress(ProgressEvent(\"docs\", \"scanning\", None, None))\n            clock[0] = 165.0\n            tick()\n            refreshed.append(recorder.current)\n\n        monkeypatch.setattr(Runner, \"__init__\", initialize)\n        assert backup_cli._run_plan(cfg, plan, dry_run=False, plan_only=False, jobs=1) is False\n        assert refreshed == [\"docs scanning 1:05\"]\n        assert capability.closed == [\"docs\"]\n        assert recorder.running is False\n\n    @pytest.mark.parametrize(\"option\", [\"--quiet\", \"--list\", \"--show-excludes\"])\n    def test_cli_quiet_and_early_returns_never_create_live_status(\n        self,\n        tmp_path: Path,\n        cli_display: tuple[StatusRecorder, StringIO],\n        option: str,\n    ) -> None:\n        recorder, stream = cli_display\n        source = tmp_path / \"source\"\n        source.mkdir()\n        (source / \"payload\").write_bytes(b\"actual CLI archive\")\n        out = tmp_path / \"result.tar.gz\"\n        config = tmp_path / \"buvis-backup.yaml\"\n        config.write_text(\n            json.dumps(\n                {\n                    \"excludes\": [\"private-cache\"],\n                    \"instances\": {\n                        \"docs\": {\n                            \"use\": \"tar-archive\",\n                            \"with\": {\n                                \"source\": str(source),\n                                \"out\": str(out),\n                                \"engine\": \"python-tarfile\",\n                            },\n                        }\n                    },\n                }\n            ),\n            encoding=\"utf-8\",\n        )\n        args = [\"--config-dir\", str(tmp_path), \"--config\", str(config)]\n        args += [option, \"docs\"] if option == \"--show-excludes\" else [\"--only\", \"docs\", option]\n        backup_cli.cli.main(args=args, standalone_mode=False)\n        assert recorder.created == []\n        assert out.exists() is (option == \"--quiet\")\n        output = stream.getvalue()\n        if option == \"--quiet\":\n            assert str(out) in output\n            assert output.splitlines()[-1].endswith(\"archived 1, skipped 0, failed 0\")\n        elif option == \"--show-excludes\":\n            assert \"private-cache\" in output\n        else:\n            assert \"docs\" in output\n\n    def test_cli_report_retries_pending_result_after_interrupt_without_duplicate_counts(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n    ) -> None:\n        _, stream = cli_display\n        results = result_lines()\n        assert backup_cli._report_steps(results) is True\n        expected = stream.getvalue()\n        stream.seek(0)\n        stream.truncate()\n        delivered: list[StepResult] = []\n        interrupts: list[bool] = []\n\n        def before_result(step: StepResult) -> None:\n            delivered.append(step)\n            if len(delivered) == 1:\n                raise KeyboardInterrupt\n\n        assert (\n            backup_cli._report_steps(\n                iter(results),\n                on_interrupt=lambda: interrupts.append(True),\n                on_result=before_result,\n            )\n            is True\n        )\n        assert delivered == [results[0], *results]\n        assert interrupts == [True]\n        assert stream.getvalue() == expected\n\n    def test_cli_result_callback_error_is_surfaced_before_printing_result(\n        self,\n        cli_display: tuple[StatusRecorder, StringIO],\n    ) -> None:\n        _, stream = cli_display\n\n        def fail_render(step: StepResult) -> None:\n            raise RuntimeError(f\"cannot render {step.label}\")\n\n        with pytest.raises(RuntimeError, match=\"cannot render docs-old\"):\n            backup_cli._report_steps([StepResult(\"docs-old\", False, \"not printed\")], on_result=fail_render)\n        assert \"not printed\" not in stream.getvalue()\n\n    def test_cli_interrupted_live_run_closes_capability_and_status_before_exit_130(\n        self,\n        monkeypatch: pytest.MonkeyPatch,\n        cli_display: tuple[StatusRecorder, StringIO],\n    ) -> None:\n        recorder, stream = cli_display\n        cfg, plan, capability = controlled_plan(monkeypatch, result_lines())\n        recorder.interrupt = True\n        with pytest.raises(SystemExit) as caught:\n            backup_cli._run_plan(cfg, plan, dry_run=False, plan_only=False, jobs=1)\n        assert caught.value.code == 130\n        assert recorder.running is False\n        assert recorder.created == [\"\"]\n        assert capability.closed\n        assert set(capability.closed) <= {label for label, _ in plan}\n        assert \"interrupted:\" in stream.getvalue()\n\n    @pytest.mark.parametrize(\"tty,quiet\", [(False, False), (True, True), (False, True)])\n    def test_no_live_output_when_not_a_tty_or_quiet(\n        self,\n        monkeypatch: pytest.MonkeyPatch,\n        cli_display: tuple[StatusRecorder, StringIO],\n        tty: bool,\n        quiet: bool,\n    ) -> None:\n        recorder, stream = cli_display\n        results = result_lines()\n        cfg, plan, capability = controlled_plan(monkeypatch, results)\n        monkeypatch.setattr(sys.stdout, \"isatty\", lambda: tty)\n        expected_failure = backup_cli._report_steps(results)\n        expected = stream.getvalue()\n        stream.seek(0)\n        stream.truncate()\n        failed = backup_cli._run_plan(cfg, plan, dry_run=False, plan_only=False, jobs=1, quiet=quiet)\n        assert failed is expected_failure is True\n        assert stream.getvalue() == expected\n        for result in results:\n            assert result.message in expected\n        assert len(expected.splitlines()) > len(results)\n        assert recorder.created == []\n        assert sorted(capability.closed) == sorted(result.label for result in results)\n\n    @pytest.mark.parametrize(\n        \"dry_run,plan_only,quiet,tty\",\n        [\n            (False, False, True, True),\n            (False, False, False, False),\n            (True, False, False, True),\n            (False, True, False, True),\n        ],\n    )\n    def test_cli_disabled_modes_pass_no_progress_or_tick_callbacks_to_real_runner(\n        self,\n        tmp_path: Path,\n        monkeypatch: pytest.MonkeyPatch,\n        cli_display: tuple[StatusRecorder, StringIO],\n        dry_run: bool,\n        plan_only: bool,\n        quiet: bool,\n        tty: bool,\n    ) -> None:\n        recorder, _ = cli_display\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"payload\").write_bytes(b\"source bytes\")\n        out = tmp_path / \"out.tar.gz\"\n        instance = BackupInstance(use=\"tar-archive\", with_={\"source\": str(source), \"out\": str(out)})\n        cfg = BackupConfig(instances={\"docs\": instance})\n        calls: list[dict[str, object]] = []\n        original = Runner.__init__\n\n        def initialize(runner: Runner, *args: object, **kwargs: object) -> None:\n            calls.append(kwargs)\n            original(runner, *args, **kwargs)\n\n        monkeypatch.setattr(Runner, \"__init__\", initialize)\n        monkeypatch.setattr(sys.stdout, \"isatty\", lambda: tty)\n        assert (\n            backup_cli._run_plan(\n                cfg,\n                [(\"docs\", instance)],\n                dry_run=dry_run,\n                plan_only=plan_only,\n                quiet=quiet,\n            )\n            is False\n        )\n        assert len(calls) == 1\n        assert calls[0].get(\"on_progress\") is None\n        assert calls[0].get(\"on_tick\") is None\n        assert recorder.created == []\n        assert out.exists() is (not dry_run and not plan_only)\n\n    def test_cli_live_run_removes_completed_labels_before_each…1290 tokens truncated…Zettelsequence utilities\ntests/\n├── lib/                        # library tests\n│   ├── pybase/\n│   ├── zettel/\n│   └── zettel_integrations/\n└── tools/                      # CLI tool tests\ntools/                          # Dev command shims (on PATH via mise) + helpers\n├── release                     # public shim → mise `release` task\n└── lib/                        # helpers, invoked by path (NOT on PATH)\n    ├── release                 # release impl: bump+tag+push\n    ├── pin_deps.py             # pin deps from uv.lock for publishing\n    ├── scaffold.py             # scaffold a new tool\n    ├── check_audit_ignores.py  # pip-audit suppression guard (+ audit/ config)\n    ├── check_tool_wiring.py    # pre-commit tool-wiring check\n    ├── parity_brief_portfolio.py\n    └── gen_zettel_writer_fixtures.py\n```\n\n**Key patterns:**\n\n- **Single package**: `buvis-gems` on PyPI, one `uv tool install`\n- **Namespace package**: `src/lib/buvis/` has no `__init__.py`\n- **Hatch packages**: each `src/tools/<name>/` maps to top-level `<name>` in wheel\n- **Libraries are internal**: pybase + zettel not published separately\n- **All-interface rule**: every command/action must work across CLI, TUI, API, and WebUI\n\n## Tool Structure\n\nEvery tool under `src/tools/<name>/` follows a base layout:\n\n```text\ntool_name/\n├── __init__.py\n├── __main__.py\n├── cli.py              # Click entry point\n├── settings.py         # Tool-specific settings\n└── commands/           # One module per CLI command\n```\n\nAdd subdirs only when needed:\n\n| Dir | When | Example |\n|-----|------|---------|\n| `adapters/` | External service clients | fctracker, readerctl |\n| `domain/` | Business logic beyond simple commands | fctracker |\n| `shared/` | Code reused across commands | zseq |\n\n> `bim/commands/serve/frontend/` contains the WebUI SvelteKit app — the only tool with a frontend subtree.\n\n> `bim/commands/doc/` follows the existing `commands/serve/`-style group pattern with a `shared/` subdir holding cross-command utilities (pipeline, OCR/classifier/extractor adapters, state DB, issuer registry, zettel writer).\n\n## Code Conventions\n\n**Type hints** — modern style, no `Optional`:\n\n```python\nfrom __future__ import annotations\ndef foo(path: Path | None = None) -> list[str]: ...\n```\n\n**Imports**:\n\n- Explicit `__all__` in `__init__.py`\n- `TYPE_CHECKING` guards for type-only imports\n\n**Docstrings**: Google format\n\n**CLI pattern**: Click-based. `buvis_options` adds `--version`, `--config`, `--log-level`, `--debug`, and `--update` to every tool automatically:\n\n```python\n@click.command()\n@buvis_options\n@click.pass_context\ndef cli(ctx: click.Context) -> None:\n    settings = get_settings(ctx)\n    ...\n```\n\n**Lazy imports in CLI handlers**: import command classes inside handler functions, not at module level. This avoids pulling in optional/heavy dependencies before the user picks a subcommand:\n\n```python\n@cli.command(\"create\")\n@click.pass_context\ndef create(ctx):\n    from bim.commands.create_note.create_note import CommandCreateNote\n    ...\n```\n\n## Error Handling\n\n**Command layer** (`commands/`):\n- Return `CommandResult` for all outcomes — success and failure\n- Catch expected exceptions (e.g. `FileNotFoundError`) internally, return `CommandResult(success=False, error=str(exc))`\n- No `console.panic()` or `sys.exit()` inside command classes\n- No custom exception classes for control flow\n\n**CLI layer** (`cli.py`):\n- Inspect `CommandResult` and call `console.panic()` / `console.failure()` / `console.success()`\n- Use `console.report_result()` for standardized output\n- Catch `ImportError` for optional deps, call `console.require_import()`\n- Catch `FatalError` for unrecoverable infrastructure failures\n\n**Click argument validation**:\n- Avoid parse-time validators that short-circuit before the callback (`click.Path(exists=True)`, `IntRange`, custom `ParamType.convert` that raises). They emit Click's default `Usage: ... Error: ...` formatting and bypass the buvis console.\n- Validate inside the callback instead: `if not path.is_file(): console.panic(f\"file not found: {path}\"); return`.\n- `click.Choice` is the exception — its parse-time error lists the valid values, which is more useful than a rewritten message.\n\n**Console methods**:\n- Fatal (exit): `console.panic(msg)` — prints + exits with code 1\n- Recoverable: `console.failure(msg)` — prints, continues\n- Status: `console.success()`, `console.warning()`, `console.info()`\n- All user-facing output must route through `console`. No `print()`, `sys.stdout.write()`, `sys.stderr.write()`, `click.echo()`, `click.secho()`, or the Python logging module. Plain writes bypass the buvis prefix markers (`✘`, `✓`, etc.) and become indistinguishable from stray output, which is what makes a missed `console.panic` look like a print statement to the user.\n- The one sanctioned exception is the `dot filter` clean/smudge plumbing, which writes git's blob payload as raw bytes on stdout and at most one error line on stderr, because git owns both streams and a console marker would corrupt the payload (discovery R12).\n- Never let raw exceptions (stack traces) reach the user.\n\n## Invariants (evolution guardrails)\n\nThese encode the failure classes surfaced by the 2026-07-09 evolution assessment (`docs/dev/project-management/reviews/evolution-assessment-2026-07-09.md`). Each is either **HOLDS** (enforce it) or a **GAP** (a tracked PRD is closing it — write new code to the target state, not the current one).\n\n- **Atomic persistence** — never persist a note, state file, or config with a bare `Path.write_text`/`open(...,\"w\")`. Use `pybase.filesystem.atomic_write` (tempfile + fsync + `os.replace`). Truncate-then-write loses data on crash/ENOSPC. *HOLDS for the library and note/updater write paths (00041) — keep it, except `ConfigWriter.write` (`configuration/config_writer.py`), which still does a bare `write_text` — deliberately out of scope for 00041. GAP → pidash was closed by retiring pidash (00071); autopilot-state durability now lives in the buvis home repo (tracon/statectl), not gems.*\n- **Confine request-derived paths** — any filesystem path built from an HTTP request / external input must be `resolve()`d and asserted under an allowed root before read/write/delete/open. Network-facing servers must have auth + `TrustedHostMiddleware`. *HOLDS (00042) — bim serve confines request paths via `confine_path` (403 outside the vault/archive roots), mints a startup token required as `X-Buvis-Token`, installs `TrustedHostMiddleware`, and warns on a non-loopback bind (`commands/serve/_security.py`). Keep it.*\n- **The library stays interface-agnostic** — `src/lib/buvis/pybase/` must not import a UI framework at module import time or emit output outside the console adapter. No import-time Click monkey-patching, no `sys.exit`/`click.echo`/`print` in lib code. A TUI/API/WebUI process must be able to `import` settings without pulling Click. *HOLDS (00052) — keep it.*\n- **One action, one implementation across interfaces** — CLI/TUI/API/WebUI adapters must drive the same command class / use case through the composition root and return `CommandResult`; do not reimplement business logic per interface (dot's TUI is the anti-pattern; bim's serve action registry is the exemplar). *HOLDS (00051 design → 00053/00054) — the all-interface seam design (00051) is realized: dot's git ops unified behind `DotGitService` (00053) and bim's serve/TUI converged on the shared action registry (00054). Keep it.*\n- **Claim/lifecycle release on any exit** — resource claims and locks release in `finally` (or catch `BaseException`), never only `except Exception`; `KeyboardInterrupt` must not leak a claim. *HOLDS (00044) — the bim doc claim/dedup pipeline releases claims and locks in `finally` (`commands/doc/shared/`); keep it.*\n- **`CommandResult` discipline** — commands return `CommandResult`; the CLI/adapter layer renders it (`console.report_result`) and maps exit/HTTP status. No `sys.exit`/`console.panic` inside command classes. *HOLDS in `src/tools/*/commands/**` — keep it.*\n- **Clean-architecture layering + tool isolation** — zettel `domain → application → infrastructure → integrations` one-directional; no cross-tool imports; no `src/lib → src/tools`. *HOLDS — keep it.*\n\n## Testing\n\n- pytest + pytest-mock + pytest-cov\n- Tests in `tests/` mirror `src/lib/` and `src/tools/` structure\n- Mock subprocess calls heavily\n- Class-based test organization\n- **No unused imports/variables**\n- **Markers**: `pytest -m <tool>` runs one tool, `pytest -m lib` runs library tests, `pytest -m \"not bim\"` excludes a tool. Auto-applied by path in `tests/conftest.py` — no decorators needed. Scaffold registers markers for new tools.\n- **Snapshot tests** (`@pytest.mark.snapshot`) only run on the canonical env (Linux + Python 3.12) — SVG output from Rich/Textual differs across OS/Python so baselines must come from one place. Anywhere else they are auto-skipped. To regenerate baselines run the `update-snapshots` GitHub workflow (`gh workflow run update-snapshots.yml`); it runs `pytest --snapshot-update` on the canonical env and commits the result. Force locally with `BUVIS_SNAPSHOT_CANONICAL=1` only if you know what you're doing.\n\n## Installation\n\n```bash\nuv tool install buvis-gems              # core only (no tool-specific deps)\nuv tool install buvis-gems[bim]         # with jira support\nuv tool install buvis-gems[bim-web]     # bim web UI deps\nuv tool install buvis-gems[all]         # everything\nuv tool upgrade buvis-gems              # update\n```\n\nExtras: `bim`, `bim-web`, `doc`, `dot`, `fren`, `morph`, `muc`, `pinger`, `postup`, `postup-web`, `readerctl`, `all`\n\n## Release\n\n> Full procedure (version authority, checks, destinations, partial-failure recovery): `docs/dev/procedures/releasing.md`.\n\n```bash\nrelease patch|minor|major              # bump, tag, push → CI publishes to PyPI\nrelease --pre rc1                      # pre-release current version to TestPyPI\nrelease --pre rc1 minor                # bump + pre-release to TestPyPI\nrelease                                # after rc: strip suffix, release stable to PyPI\nrelease local                          # build .devN wheel + install locally\nrelease --dry-run [--pre rc1] [patch]  # preview without changes\n```\n\n`mise` adds `tools` to PATH (shims; `tools/lib` holds the implementations). Tags with `rc` in the name publish to TestPyPI; stable tags go to PyPI. Manual workflow dispatch defaults to TestPyPI.\n\n**First-time setup** (already done for buvis-gems):\n- test.pypi.org: add trusted publisher (owner: `buvis`, repo: `gems`, workflow: `publish.yml`, env: `testpypi`)\n- GitHub repo settings: create `testpypi` and `pypi` environments\n\n**Why explicit version in pyproject.toml?** maturin reads the version from `pyproject.toml` at build time to compile the Rust extension. Tag-based versioning (hatch-vcs) would require glue to inject the version before maturin sees it. Pure Python projects like mkdocs-zettelkasten use hatch-vcs instead — the version derives from the git tag, no file to keep in sync, no bump commits.\n\nRelevant reviewed API contracts (not acceptance criteria):\n\n```python\n@click.option(\"--quiet\", is_flag=True, help=\"Hide live progress; keep final results and the summary.\")\n\ndef _format_progress(event: ProgressEvent, elapsed: float) -> str: ...\n\nclass _LiveProgress:\n    def on_progress(self, event: ProgressEvent) -> None: ...\n    def refresh(self) -> None: ...\n    def finish(self, label: str) -> None: ...\n    def close(self) -> None: ...\n\ndef _report_steps(\n    steps: Iterable[StepResult], *, dry_run: bool = False,\n    on_interrupt: Callable[[], None] | None = None,\n    on_result: Callable[[StepResult], None] | None = None,\n) -> bool: ...\n\ndef _run_plan(\n    cfg: BackupConfig, plan: list[tuple[str, BackupInstance]], *,\n    dry_run: bool, plan_only: bool, jobs: int = 3, quiet: bool = False,\n) -> bool: ...\n```\n\nAdd `quiet: bool` to the Click callback and forward it to `_run_plan`. Live mode is exactly `not quiet and sys.stdout.isatty() and not dry_run and not plan_only`; use stdout as the explicit functional contract specifies, even though introductory PRD wording mentions stderr/stdout. Existing list/show-excludes early returns never construct live status. In every disabled mode, construct no status and pass `on_progress=None`, `on_tick=None` to `Runner`.\n\n`_format_progress` returns `label phase [NN%] M:SS` when both byte fields exist, `total_bytes > 0` and `phase != \"finalizing\"`; `NN = min(99, done_bytes * 100 // total_bytes)`. Otherwise omit the percentage and its surrounding space. Brackets are literal display characters. Elapsed seconds are `max(0, int(elapsed))`, formatted with `divmod(seconds, 60)`; minutes can exceed 59 and seconds always have two digits. Examples: `docs archiving [37%] 1:05`, `git scanning 0:02`, `git finalizing 2:00`.\n\n`_LiveProgress` stores latest events and first-seen `time.monotonic()` timestamps by label, in first-event insertion order. Waiting/unsubmitted instances are not active. Phase changes preserve the first timestamp. `on_progress` replaces the label's latest event and refreshes; `refresh` joins active strings with `\" | \"` and calls `Status.update`. Use `rich.text.Text` for the rendered string passed to `Status.update` so configured labels and literal percentage brackets cannot be parsed as Rich markup. Only CLI owns Rich imports and status objects.\n\nCreate at most one `console.status(\"\")` object per live run, lazily at the first event, and start it only while active labels exist. Stop it when the last active label finishes; restart the same object if later submitted work emits its first event. `finish(label)` removes the label and timestamp idempotently and refreshes the remaining jobs. `close()` stops the status idempotently. No status is needed for an empty run or only preflight failures.\n\nCall `_report_steps(..., on_result=lambda step: live.finish(step.label))` in live mode. The report loop invokes `on_result(pending)` immediately before `_report_step(pending)` inside its existing interrupt-handling boundary. Keep the pending result and counters across rendering retries; `finish` is idempotent, and each result still affects counters once. A completed/failed/skipped/cancelled label disappears before its final line prints. Keep `_report_step`, final messages, summary counts and ordinary exit codes unchanged. `--quiet` suppresses redraws only; every result, skip, failure and summary remains visible.\n\nUse `finally` in `_run_plan` to close the original runner generator and the live status on every exit. Preserve the existing retained-iterator interrupt path and exit-130 message. Status updates interrupted by `KeyboardInterrupt` reach the runner or report-loop cancellation owner; cleanup must not leave a spinner or active writer running. Do not move execution into a UI thread.\nRead-only support modules: /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/step_result.py, /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/config.py, /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/capabilities/__init__.py, /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/runner.py\nREADING BUDGET: cli.py imports/report loop lines1-65, _run_plan near223-267, Click options/callback near270-end; other selectors need no edits. CHANGELOG.md only Unreleased/Added first25 lines. Ordered work: formatter+zero-arg _LiveProgress lifecycle, then on_result seam in report loop, then _run_plan callbacks/cleanup, then quiet option forwarding/changelog. Narrow per-surface tests use format then cli/quiet selector. Existing _run_plan raises SystemExit130 on runner.interrupted; preserve result counts and retained pending iterator. New contract-owned six-argument _run_plan may need justified PLR0913 exception. Native source route: UI row1 Gemini lacks independent review support in autocodex; operator-authorized pre-dispatch fallback is native logical opus gpt-6.1-sol/high, with independent Anthropic completion review.\n\nUse Python patterns at /Users/bob/.agents/skills/python-patterns/SKILL.md for Python edits. Keep modified functions under50 lines and Python files under800 lines, preserving behavior; small helpers within allowlisted source are permitted. Existing task tests are read-only. Add a focused Added CHANGELOG entry under Unreleased for this task; it is mandatory in each feature commit. Do not commit; coordinator handles commits. Native implementation route OpenAI gpt-6.1-sol/high, logical opus; independent completion review route Anthropic Opus/xhigh is supported by autocodex driver.\n\n\n## Files you may read and modify\n\n/Users/bob/git/src/github.com/buvis/gems/src/tools/backup/cli.py\n/Users/bob/git/src/github.com/buvis/gems/CHANGELOG.md\n\nRead only the files listed above. If a file or symbol you need is not\nlisted, stop and report it as a blocker — do not run broad `rg` sweeps to\ndiscover scope.\n\n\n\n### Code quality rules (mandatory)\n\nFollow these four rules. They override any instinct to \"improve\" the code\nbeyond what the failing tests require.\n\n**1. Think before coding.** Re-read the task and the failing tests. If scope,\ndata shape, target file, or success criteria are ambiguous - more than one\nreasonable implementation would pass the tests differently - STOP and report\nthe ambiguity as a blocker. Do not guess and proceed.\n\n**2. Simplicity.** Write the simplest code that makes the failing tests pass.\n\n- No abstractions, helpers, or interfaces built for a single caller.\n- No error handling, fallbacks, or validation for inputs the tests never\n  exercise. Validate at real system boundaries only.\n- No features, options, or configuration the task did not ask for.\n- If your draft runs long and the same behavior fits in far fewer lines,\n  rewrite it before returning.\n\n**3. Surgical changes.** Touch only what the task requires.\n\n- Do not refactor, reformat, or \"improve\" code outside the change.\n- Match the surrounding style even if you would write it differently.\n- Remove imports, variables, and functions that YOUR change orphaned. Do not\n  delete pre-existing dead code - mention it instead.\n- Every changed line must trace to the task or a failing test.\n\n**4. Goal-driven.** The failing tests are the spec. Make them pass - do not\nmodify them, do not weaken them, do not add tests. If a test looks wrong,\nreport it as a blocker rather than changing it.\n\nAbort and report if you read more than 100K of total input. Return the\npartial result and an abort_reason: context_overrun field.\n\nRead every file before your first Edit to it. Never call bash `head`,\n`tail`, `cat`, `grep`, or `find` - a hook blocks them. Use the Read tool\n(offset/limit), `rg`, or `rg --files` instead. Never combine an inspection\n(read, list, search, diff) with a test, lint or build invocation in one Bash\ncall - run them as two calls, because a combined command has two ways to hang\nand one exit code. Pass an explicit `timeout` on every Bash call: 60000 ms for\nan inspection, 300000 ms for a lint run or a narrow test run, 600000 ms for a\nfull suite or a full build.\n\nRun only the test files this task names (the tests you wrote, or the\nfailing tests in your prompt), with `-q --tb=line`. Never run a whole test\ndirectory or `dev/bin/release-checks`: the orchestrator runs the full suite\nonce, after every task. Read the pass count and exit code from that one\nrun; never re-run a suite to recover a number.\n\nEnd your report with `ASSUMPTIONS:` - one line per assumption you made\nwhere the task, tests, or listed files were silent (guessed interface, data\nshape, resolved ambiguity, unstated behavior). Write `ASSUMPTIONS: none` if\nyou made none.\n\nAlso end your report with `FILES_TOUCHED:` - one line per file you created\nor modified, path relative to the repo root. Write `FILES_TOUCHED: none` if\nyou changed no files.\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19912-c8f8-7b20-a4a1-eba5c0157559","create_time":1793569511.982044}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
