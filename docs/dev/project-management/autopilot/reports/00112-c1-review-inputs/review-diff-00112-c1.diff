gems/docs/dev/project-management/reviews/00110-backup-plan-preview-and-output-resolution-v1-review-1.md::decision-gate\",\n    \"/Users/bob/git/src/github.com/buvis/gems/docs/dev/project-management/reviews/00111-backup-parallel-jobs-and-cancellation-v1-review-1.md::decision-gate\",\n    \"/Users/bob/git/src/github.com/buvis/gems/docs/dev/project-management/reviews/00111-backup-parallel-jobs-and-cancellation-v1-review-1.md::tail-sweep\"\n  ],\n  \"contract_card\": \"# PRD 00111 complete\\n\\nstep: Phase 9 finalized; next: fresh build session for PRD 00112.\\ninvariants: batch 202610292344 preserved; PRD 00111 moved to done and nine task attempts archived; cycle 1 review and all provenance retained.\\nFinal verification: 6237 passed, 16 skipped; Ruff and mypy clean. Deferred tar descendant supervision migrated to the batch ledger.\\nRead the current session brief and installed phase-build.md. Select the next PRD; do not repeat PRD 00111 review or Tail sweep.\",\n  \"prd_budget_since\": \"2026-11-01T20:27:31Z\",\n  \"design_mode\": \"run\",\n  \"loop_entry\": {\n    \"entered_by\": \"loop\",\n    \"prd\": \"00112-backup-live-progress-and-quiet-v1.md\",\n    \"result\": {\n      \"stop\": null,\n      \"detail\": \"\",\n      \"prd\": \"00112-backup-live-progress-and-quiet-v1.md\",\n      \"source\": \"backlog\",\n      \"parked\": null,\n      \"custody_pending\": 0,\n      \"lane_effective\": \"full\",\n      \"catchup\": \"skip\",\n      \"design\": \"run\",\n      \"resume_target\": \"build: catchup then planning\",\n      \"batch\": \"open\"\n    }\n  }\n}\n\n","exit_code":0,"status":"completed"}}
