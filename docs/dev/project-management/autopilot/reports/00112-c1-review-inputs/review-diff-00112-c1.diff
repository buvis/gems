\n    return source\n\n\nclass TestArchiveEngineProgress:\n    @pytest.mark.parametrize(\"engine\", [\"python-tarfile\", \"system-tar\"])\n    @pytest.mark.parametrize(\"label,sizes\", [(\"docs\", [7, 19]), (\"docs-old\", [11, 31])])\n    def test_engine_reports_ordered_phases_and_selected_input_bytes_before_publication(\n        self,\n        tmp_path: Path,\n        engine: str,\n        label: str,\n        sizes: list[int],\n    ) -> None:\n        source = _create_selected_input_source(tmp_path, sizes)\n        out = tmp_path / \"out.tar.gz\"\n        out.write_bytes(b\"previous archive\")\n        events: list[ProgressEvent] = []\n        finalizing_output: list[bytes] = []\n\n        def progress(event: ProgressEvent) -> None:\n            events.append(event)\n            if event.phase == \"finalizing\":\n                finalizing_output.append(out.read_bytes())\n\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=label,\n                    source=str(source),\n                    out=str(out),\n                    engine=engine,\n                    items=[\"a\", \"a-old\", \"b\"],\n                    excludes=[\"a\"],\n                    progress=progress,\n                )\n            )\n        )\n        assert result.success is True\n        assert result.out_path == str(out)\n        assert finalizing_output == [b\"previous archive\"]\n        total = sum(sizes)\n        done = total if engine == \"python-tarfile\" else None\n        assert events[0] == ProgressEvent(label, \"scanning\", None, None)\n        assert events[1] == ProgressEvent(label, \"archiving\", 0 if done is not None else None, total)\n        assert events[-1] == ProgressEvent(label, \"finalizing\", done, total)\n        assert all(event.label == label for event in events)\n        assert all(event.total_bytes == total for event in events[1:])\n        assert all(event.phase == \"archiving\" for event in events[1:-1])\n        if engine == \"system-tar\":\n            assert all(event.done_bytes is None for event in events)\n        else:\n            assert events[-2] == ProgressEvent(label, \"archiving\", total, total)\n        with tarfile.open(out) as archive:\n            assert {Path(member.name).name for member in archive.getmembers() if member.isfile()} == {\"a-old\", \"b\"}\n        assert out.stat().st_mode & 0o777 == 0o600\n\n    @pytest.mark.parametrize(\"sizes\", [[3, 7, 11, 17], [5, 13, 19, 23]])\n    def test_engine_throttles_at_two_tenths_and_flushes_short_final_count(\n        self,\n        tmp_path: Path,\n        monkeypatch: pytest.MonkeyPatch,\n        sizes: list[int],\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        names = [\"a\", \"b\", \"c\", \"d\"]\n        for name, size in zip(names, sizes, strict=True):\n            (source / name).write_bytes(b\"x\" * size)\n        clock = [0.0]\n        moments = dict(zip(names, [0.199, 0.2, 0.399, 0.3999], strict=True))\n        original_add = tarfile.TarFile.add\n\n        def add_with_clock(archive: tarfile.TarFile, name: str, *args: object, **kwargs: object) -> None:\n            original_add(archive, name, *args, **kwargs)\n            clock[0] = moments[Path(name).name]\n\n        monkeypatch.setattr(time, \"monotonic\", lambda: clock[0])\n        monkeypatch.setattr(tarfile.TarFile, \"add\", add_with_clock)\n        events: list[ProgressEvent] = []\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=\"timed\",\n                    source=str(source),\n                    out=str(tmp_path / \"timed.tar.gz\"),\n                    engine=\"python-tarfile\",\n                    items=names,\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is True\n        total = sum(sizes)\n        assert events == [\n            ProgressEvent(\"timed\", \"scanning\", None, None),\n            ProgressEvent(\"timed\", \"archiving\", 0, total),\n            ProgressEvent(\"timed\", \"archiving\", sum(sizes[:2]), total),\n            ProgressEvent(\"timed\", \"archiving\", total, total),\n            ProgressEvent(\"timed\", \"finalizing\", total, total),\n        ]\n\n    @pytest.mark.parametrize(\"label,size\", [(\"first\", 7), (\"first-old\", 29)])\n    def test_engine_short_archive_flushes_without_waiting_or_duplicate_final_count(\n        self,\n        tmp_path: Path,\n        monkeypatch: pytest.MonkeyPatch,\n        label: str,\n        size: int,\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"payload\").write_bytes(b\"x\" * size)\n        monkeypatch.setattr(time, \"monotonic\", lambda: 42.0)\n        events: list[ProgressEvent] = []\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=label,\n                    source=str(source),\n                    out=str(tmp_path / \"out.tar.gz\"),\n                    engine=\"python-tarfile\",\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is True\n        assert events == [\n            ProgressEvent(label, \"scanning\", None, None),\n            ProgressEvent(label, \"archiving\", 0, size),\n            ProgressEvent(label, \"archiving\", size, size),\n            ProgressEvent(label, \"finalizing\", size, size),\n        ]\n\n    @pytest.mark.parametrize(\"engine\", [\"python-tarfile\", \"system-tar\"])\n    @pytest.mark.parametrize(\"items\", [None, [\"a\", \"b\"]])\n    def test_engine_direct_dry_run_never_calls_progress(\n        self,\n        tmp_path: Path,\n        engine: str,\n        items: list[str] | None,\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"a\").write_bytes(b\"first\")\n        (source / \"b\").write_bytes(b\"second payload\")\n        out = tmp_path / \"out.tar.gz\"\n        events: list[ProgressEvent] = []\n        selected: dict[str, object] = {} if items is None else {\"items\": items}\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=\"preview\",\n                    source=str(source),\n                    out=str(out),\n                    engine=engine,\n                    **selected,\n                    dry_run=True,\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is True\n        assert events == []\n        assert not out.exists()\n\n    @pytest.mark.parametrize(\"source_state\", [\"missing\", \"file\"])\n    def test_engine_unwalkable_source_emits_no_fabricated_activity(\n        self,\n        tmp_path: Path,\n        source_state: str,\n    ) -> None:\n        source = tmp_path / source_state\n        if source_state == \"file\":\n            source.write_bytes(b\"not a directory\")\n        events: list[ProgressEvent] = []\n        out = tmp_path / \"out.tar.gz\"\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=\"unwalkable\",\n                    source=str(source),\n                    out=str(out),\n                    engine=\"python-tarfile\",\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is (source_state == \"missing\")\n        assert result.skipped is (source_state == \"missing\")\n        assert events == []\n        assert not out.exists()\n\n    def test_engine_selection_skip_can_end_after_scanning(self, tmp_path: Path) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"a-old\").write_bytes(b\"near miss\")\n        (source / \"b-old\").write_bytes(b\"another near miss\")\n        events: list[ProgressEvent] = []\n        out = tmp_path / \"out.tar.gz\"\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=\"empty\",\n                    source=str(source),\n                    out=str(out),\n                    items=[\"a\", \"b\"],\n                    engine=\"python-tarfile\",\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is True\n        assert result.skipped is True\n        assert events == [ProgressEvent(\"empty\", \"scanning\", None, None)]\n        assert not out.exists()\n\n    def test_engine_unavailable_system_tar_falls_back_with_activity_only_progress(\n        self,\n        tmp_path: Path,\n        monkeypatch: pytest.MonkeyPatch,\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        payload = b\"real fallback archive payload\"\n        (source / \"payload\").write_bytes(payload)\n        out = tmp_path / \"fallback.tar.gz\"\n        events: list[ProgressEvent] = []\n        monkeypatch.setenv(\"PATH\", \"\")\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=\"fallback\",\n                    source=str(source),\n                    out=str(out),\n                    engine=\"system-tar\",\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is True\n        assert result.out_path == str(out)\n        assert \"used python engine\" in result.message\n        assert events == [\n            ProgressEvent(\"fallback\", \"scanning\", None, None),\n            ProgressEvent(\"fallback\", \"archiving\", None, len(payload)),\n            ProgressEvent(\"fallback\", \"finalizing\", None, len(payload)),\n        ]\n        with tarfile.open(out) as archive:\n            members = [member for member in archive.getmembers() if member.isfile()]\n            assert len(members) == 1\n            assert Path(members[0].name).name == \"payload\"\n            extracted = archive.extractfile(members[0])\n            assert extracted is not None\n            assert extracted.read() == payload\n\n    @pytest.mark.parametrize(\"engine\", [\"python-tarfile\", \"system-tar\"])\n    def test_engine_empty_source_reports_zero_total_and_finalizes_real_archive(\n        self,\n        tmp_path: Path,\n        engine: str,\n    ) -> None:\n        source = tmp_path / \"empty\"\n        source.mkdir()\n        out = tmp_path / \"empty.tar.gz\"\n        events: list[ProgressEvent] = []\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=\"empty\",\n                    source=str(source),\n                    out=str(out),\n                    engine=engine,\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is True\n        assert result.out_path == str(out)\n        done = 0 if engine == \"python-tarfile\" else None\n        assert events == [\n            ProgressEvent(\"empty\", \"scanning\", None, None),\n            ProgressEvent(\"empty\", \"archiving\", done, 0),\n            ProgressEvent(\"empty\", \"finalizing\", done, 0),\n        ]\n        with tarfile.open(out) as archive:\n            assert not any(member.isfile() for member in archive.getmembers())\n\n\nclass TestArchiveInputBytes:\n    @pytest.mark.parametrize(\"fixture_kind\", [\"incompressible\", \"compressible\"])\n    def test_percent_uses_input_bytes_not_output_size(self, tmp_path: Path, fixture_kind: str) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        sizes = [256 * 1024, 8192]\n        payloads = {\n            name: os.urandom(size) if fixture_kind == \"incompressible\" else b\"x\" * size\n            for name, size in zip([\"a\", \"b\"], sizes, strict=True)\n        }\n        for name, payload in payloads.items():\n            (source / name).write_bytes(payload)\n        total = sum((source / name).stat().st_size for name in payloads)\n        out = tmp_path / \"out.tar.gz\"\n        events: list[ProgressEvent] = []\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=fixture_kind,\n                    source=str(source),\n                    out=str(out),\n                    engine=\"python-tarfile\",\n                    progress=events.append,\n                )\n            )\n        )\n        assert result.success is True\n        assert out.stat().st_size != total\n        if fixture_kind == \"compressible\":\n            assert out.stat().st_size < total // 2\n        else:\n            assert out.stat().st_size > total * 0.9\n        assert events[1] == ProgressEvent(fixture_kind, \"archiving\", 0, total)\n        assert all(event.total_bytes == total for event in events[1:])\n        assert events[-2:] == [\n            ProgressEvent(fixture_kind, \"archiving\", total, total),\n            ProgressEvent(fixture_kind, \"finalizing\", total, total),\n        ]\n        with tarfile.open(out) as archive:\n            members = [member for member in archive.getmembers() if member.isfile()]\n            assert {Path(member.name).name for member in members} == set(payloads)\n            assert sum(member.size for member in members) == total\n            for member in members:\n                extracted = archive.extractfile(member)\n                assert extracted is not None\n                assert extracted.read() == payloads[Path(member.name).name]\n\n    @pytest.mark.parametrize(\"sizes\", [[7, 19], [13, 31]])\n    def test_input_bytes_counts_regular_paths_and_hardlinks_but_not_directories_or_symlinks(\n        self,\n        tmp_path: Path,\n        sizes: list[int],\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        first = source / \"a\"\n        second = source / \"a-old\"\n        first.write_bytes(b\"x\" * sizes[0])\n        second.write_bytes(b\"y\" * sizes[1])\n        hardlink = source / \"hardlink\"\n        os.link(first, hardlink)\n        directory = source / \"directory\"\n        directory.mkdir()\n        (directory / \"not-selected\").write_bytes(b\"must not recurse\")\n        symlink = source / \"symlink\"\n        symlink.symlink_to(second)\n        broken = source / \"broken\"\n        broken.symlink_to(source / \"absent\")\n        counts: list[int] = []\n        finalized: list[bool] = []\n        out = tmp_path / \"out.tar.gz\"\n        files = [first, directory, symlink, broken, second, hardlink]\n        _write_archive(out, source, files, on_bytes=counts.append, on_finalize=lambda: finalized.append(True))\n        assert counts == [sizes[0], sizes[0], sizes[0], sizes[0], sum(sizes), sum(sizes) + sizes[0]]\n        assert finalized == [True]\n        with tarfile.open(out) as archive:\n            members = {Path(member.name).name: member for member in archive.getmembers()}\n        assert set(members) == {path.name for path in files}\n        assert members[\"symlink\"].issym()\n        assert members[\"broken\"].issym()\n        assert members[\"directory\"].isdir()\n        assert members[\"hardlink\"].islnk()\n\n    def test_input_bytes_empty_writer_finalizes_without_member_callbacks(self, tmp_path: Path) -> None:\n        counts: list[int] = []\n        finalized: list[bool] = []\n        out = tmp_path / \"empty.tar.gz\"\n        _write_archive(out, tmp_path, [], on_bytes=counts.append, on_finalize=lambda: finalized.append(True))\n        assert counts == []\n        assert finalized == [True]\n        with tarfile.open(out) as archive:\n            assert archive.getmembers() == []\n\n    @pytest.mark.parametrize(\"size\", [7, 29])\n    def test_input_bytes_failed_member_preserves_output_and_never_finalizes(\n        self,\n        tmp_path: Path,\n        monkeypatch: pytest.MonkeyPatch,\n        size: int,\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        first = source / \"a\"\n        first.write_bytes(b\"x\" * size)\n        second = source / \"a-old\"\n        second.write_bytes(b\"not successfully added\")\n        out = tmp_path / \"out.tar.gz\"\n        out.write_bytes(b\"previous archive\")\n        counts: list[int] = []\n        finalized: list[bool] = []\n        original_add = tarfile.TarFile.add\n\n        def fail_second(archive: tarfile.TarFile, name: str, *args: object, **kwargs: object) -> None:\n            if Path(name) == second:\n                raise OSError(\"archive member failed\")\n            original_add(archive, name, *args, **kwargs)\n\n        monkeypatch.setattr(tarfile.TarFile, \"add\", fail_second)\n        with pytest.raises(OSError, match=\"archive member failed\"):\n            _write_archive(\n                out,\n                source,\n                [first, second],\n                on_bytes=counts.append,\n                on_finalize=lambda: finalized.append(True),\n            )\n        assert counts == [size]\n        assert finalized == []\n        assert out.read_bytes() == b\"previous archive\"\n        assert sorted(path.name for path in tmp_path.iterdir()) == [\"out.tar.gz\", \"src\"]\n\n    def test_input_bytes_state_is_local_to_each_shared_capability_run(\n        self,\n        tmp_path: Path,\n        monkeypatch: pytest.MonkeyPatch,\n    ) -> None:\n        capability = TarArchive()\n        monkeypatch.setattr(time, \"monotonic\", lambda: 42.0)\n        for label, size in [(\"a\", 7), (\"a-old\", 23)]:\n            source = tmp_path / label\n            source.mkdir()\n            (source / \"data\").write_bytes(b\"x\" * size)\n            events: list[ProgressEvent] = []\n            result = next(\n                iter(\n                    capability.run(\n                        label=label,\n                        source=str(source),\n                        out=str(tmp_path / f\"{label}.tar.gz\"),\n                        engine=\"python-tarfile\",\n                        progress=events.append,\n                    )\n                )\n            )\n            assert result.success is True\n            assert events[-2:] == [\n                ProgressEvent(label, \"archiving\", size, size),\n                ProgressEvent(label, \"finalizing\", size, size),\n            ]\n\n\nclass TestProgressExceptionsSwallowed:\n    @pytest.mark.parametrize(\n        \"exception\",\n        [\n            ValueError(\"first\"),\n            RuntimeError(\"first-old\"),\n            OSError(\"unavailable\"),\n            TypeError(\"unsupported\"),\n            ProgressConsumerError(\"consumer failed\"),\n        ],\n    )\n    def test_ordinary_progress_exception_is_swallowed_after_delivering_exact_event(self, exception: Exception) -> None:\n        events = [ProgressEvent(\"a\", \"archiving\", 7, 31), ProgressEvent(\"a-old\", \"finalizing\", 19, 37)]\n        received: list[ProgressEvent] = []\n\n        def callback(event: ProgressEvent) -> None:\n            received.append(event)\n            raise exception\n\n        for event in events:\n            tar_archive._emit_progress(callback, event)\n        assert received == events\n        tar_archive._emit_progress(None, events[0])\n\n    @pytest.mark.parametrize(\"exception\", [KeyboardInterrupt(), SystemExit(7), GeneratorExit(), BaseException(\"stop\")])\n    def test_base_exception_is_not_swallowed_by_progress_emitter(self, exception: BaseException) -> None:\n        event = ProgressEvent(\"interrupt\", \"scanning\", None, None)\n        received: list[ProgressEvent] = []\n\n        def callback(delivered: ProgressEvent) -> None:\n            received.append(delivered)\n            raise exception\n\n        with pytest.raises(type(exception)) as caught:\n            tar_archive._emit_progress(callback, event)\n        assert caught.value is exception\n        assert received == [event]\n\n    @pytest.mark.parametrize(\"phase\", [\"scanning\", \"archiving\", \"finalizing\"])\n    def test_callback_exception_is_swallowed_and_real_engine_archive_finishes(self, tmp_path: Path, phase: str) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"a\").write_bytes(b\"first\")\n        (source / \"a-old\").write_bytes(b\"second payload\")\n        out = tmp_path / \"out.tar.gz\"\n        events: list[ProgressEvent] = []\n\n        def callback(event: ProgressEvent) -> None:\n            events.append(event)\n            if event.phase == phase:\n                raise RuntimeError(\"consumer unavailable\")\n\n        result = next(\n            iter(\n                TarArchive().run(\n                    label=\"resilient\",\n                    source=str(source),\n                    out=str(out),\n                    engine=\"python-tarfile\",\n                    progress=callback,\n                )\n            )\n        )\n        assert result.success is True\n        assert events[0] == ProgressEvent(\"resilient\", \"scanning\", None, None)\n        assert events[-1] == ProgressEvent(\"resilient\", \"finalizing\", 19, 19)\n        with tarfile.open(out) as archive:\n            assert {Path(member.name).name for member in archive.getmembers() if member.isfile()} == {\"a\", \"a-old\"}\n\n    @pytest.mark.parametrize(\"exception\", [KeyboardInterrupt(), SystemExit(7)])\n    def test_engine_interrupt_is_not_swallowed_and_writer_cleans_temporary_archive(\n        self,\n        tmp_path: Path,\n        exception: BaseException,\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        payload = source / \"a\"\n        payload.write_bytes(b\"first\")\n        out = tmp_path / \"out.tar.gz\"\n        out.write_bytes(b\"previous archive\")\n        cancel = threading.Event()\n        received: list[int] = []\n\n        def callback(done: int) -> None:\n            received.append(done)\n            cancel.set()\n            raise exception\n\n        with pytest.raises(type(exception)) as caught:\n            _write_archive(out, source, [payload], cancel=cancel, on_bytes=callback)\n        assert caught.value is exception\n        assert received == [5]\n        assert out.read_bytes() == b\"previous archive\"\n        assert sorted(path.name for path in tmp_path.iterdir()) == [\"out.tar.gz\", \"src\"]\n\n/Users/bob/git/src/github.com/buvis/gems/tests/tools/backup/progress_engine_cases.py\nfrom __future__ import annotations\n\nimport os\nimport subprocess\nimport tarfile\nimport threading\nfrom pathlib import Path\n\nimport pytest\n\nfrom backup.capabilities import tar_archive\nfrom backup.capabilities.tar_archive import TarArchive, _write_archive\nfrom backup.step_result import ProgressEvent\n\n\nclass TestStrengthenedEngineProgress:\n    def test_input_bytes_uses_member_size_before_add_changes_source(\n        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n    ) -> None:\n        payload = tmp_path / \"payload\"\n        payload.write_bytes(b\"original\")\n        original_add = tarfile.TarFile.add\n\n        def add_then_change(archive: tarfile.TarFile, name: str, *args: object, **kwargs: object) -> None:\n            original_add(archive, name, *args, **kwargs)\n            Path(name).write_bytes(b\"changed source with a different size\")\n\n        monkeypatch.setattr(tarfile.TarFile, \"add\", add_then_change)\n        counts: list[int] = []\n        out = tmp_path / \"out.tar.gz\"\n        _write_archive(out, tmp_path, [payload], on_bytes=counts.append)\n        assert counts == [len(b\"original\")]\n        with tarfile.open(out) as archive:\n            member = archive.getmember(\"payload\")\n            extracted = archive.extractfile(member)\n            assert extracted is not None\n            assert extracted.read() == b\"original\"\n\n    @pytest.mark.parametrize(\"items\", [None, [\"payload\"]])\n    def test_engine_scanning_is_delivered_before_selection_or_tree_walk(\n        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, items: list[str] | None\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"payload\").write_bytes(b\"input\")\n        events: list[ProgressEvent] = []\n        boundary_events: list[list[ProgressEvent]] = []\n        walk_name = \"_walk_tree\" if items is None else \"_select_items\"\n        original_walk = getattr(tar_archive, walk_name)\n\n        def walk_after_scanning(*args: object, **kwargs: object) -> object:\n            boundary_events.append(events.copy())\n            return original_walk(*args, **kwargs)\n\n        monkeypatch.setattr(tar_archive, walk_name, walk_after_scanning)\n        selected: dict[str, object] = {} if items is None else {\"items\": items}\n        result = next(\n            TarArchive().run(\n                label=\"ordered\",\n                source=str(source),\n                out=str(tmp_path / \"out.tar.gz\"),\n                engine=\"python-tarfile\",\n                progress=events.append,\n                **selected,\n            )\n        )\n        assert result.success is True\n        assert boundary_events == [[ProgressEvent(\"ordered\", \"scanning\", None, None)]]\n\n    def test_input_bytes_failed_stream_close_never_finalizes_or_publishes(\n        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n    ) -> None:\n        out = tmp_path / \"out.tar.gz\"\n        out.write_bytes(b\"previous archive\")\n        original_close = tarfile.TarFile.close\n\n        def fail_close(archive: tarfile.TarFile) -> None:\n            was_closed = archive.closed\n            original_close(archive)\n            if not was_closed:\n                raise OSError(\"stream close failed\")\n\n        monkeypatch.setattr(tarfile.TarFile, \"close\", fail_close)\n        counts: list[int] = []\n        finalized: list[bool] = []\n        with pytest.raises(OSError, match=\"stream close failed\"):\n            _write_archive(out, tmp_path, [], on_bytes=counts.append, on_finalize=lambda: finalized.append(True))\n        assert counts == []\n        assert finalized == []\n        assert out.read_bytes() == b\"previous archive\"\n        assert list(tmp_path.iterdir()) == [out]\n\n    @pytest.mark.parametrize(\"engine\", [\"python-tarfile\", \"system-tar\"])\n    def test_engine_syncs_closed_archive_before_atomic_publication(\n        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, engine: str\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"payload\").write_bytes(b\"input\")\n        out = tmp_path / \"out.tar.gz\"\n        out.write_bytes(b\"previous archive\")\n        stages: list[str] = []\n        original_sync, original_replace = os.fsync, os.replace\n\n        def sync(fd: int) -> None:\n            original_sync(fd)\n            stages.append(\"synced\")\n\n        def publish(*args: object, **kwargs: object) -> None:\n            stages.append(\"published\")\n            original_replace(*args, **kwargs)\n\n        def progress(event: ProgressEvent) -> None:\n            if event.phase == \"finalizing\":\n                stages.append(\"closed\")\n                assert out.read_bytes() == b\"previous archive\"\n\n        monkeypatch.setattr(os, \"fsync\", sync)\n        monkeypatch.setattr(os, \"replace\", publish)\n        result = next(\n            TarArchive().run(label=\"durable\", source=str(source), out=str(out), engine=engine, progress=progress)\n        )\n        assert result.success is True\n        assert stages == [\"closed\", \"synced\", \"published\"]\n        with tarfile.open(out) as archive:\n            assert any(member.isfile() for member in archive.getmembers())\n\n    def test_engine_cancellation_without_callback_exception_preserves_output_and_cleans_temp(\n        self, tmp_path: Path\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        payload = source / \"payload\"\n        payload.write_bytes(b\"input\")\n        out = tmp_path / \"out.tar.gz\"\n        out.write_bytes(b\"previous archive\")\n        cancel = threading.Event()\n        counts: list[int] = []\n\n        def cancel_after_member(done: int) -> None:\n            counts.append(done)\n            cancel.set()\n\n        with pytest.raises(tar_archive.ArchiveCancelled):\n            _write_archive(out, source, [payload], cancel=cancel, on_bytes=cancel_after_member)\n        assert counts == [5]\n        assert out.read_bytes() == b\"previous archive\"\n        assert sorted(path.name for path in tmp_path.iterdir()) == [\"out.tar.gz\", \"src\"]\n\n    def test_engine_system_tar_completes_subprocess_without_python_fallback(\n        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"payload\").write_bytes(b\"system input\")\n        out = tmp_path / \"out.tar.gz\"\n        processes: list[subprocess.Popen[bytes]] = []\n        original_popen, original_open = subprocess.Popen, tarfile.open\n\n        def launch(*args: object, **kwargs: object) -> subprocess.Popen[bytes]:\n            process = original_popen(*args, **kwargs)\n            processes.append(process)\n            return process\n\n        def open_without_python_writer(*args: object, **kwargs: object) -> tarfile.TarFile:\n            assert not str(kwargs.get(\"mode\", \"r\")).startswith(\"w\"), \"unexpected Python fallback\"\n            return original_open(*args, **kwargs)\n\n        monkeypatch.setattr(subprocess, \"Popen\", launch)\n        monkeypatch.setattr(tarfile, \"open\", open_without_python_writer)\n        events: list[ProgressEvent] = []\n        result = next(\n            TarArchive().run(\n                label=\"system\", source=str(source), out=str(out), engine=\"system-tar\", progress=events.append\n            )\n        )\n        assert result.success is True\n        assert \"used python engine\" not in result.message\n        assert [process.returncode for process in processes] == [0]\n        assert events[-1] == ProgressEvent(\"system\", \"finalizing\", None, len(b\"system input\"))\n        with tarfile.open(out) as archive:\n            member = next(member for member in archive.getmembers() if member.isfile())\n            extracted = archive.extractfile(member)\n            assert extracted is not None\n            assert extracted.read() == b\"system input\"\n\n    @pytest.mark.parametrize(\"exception\", [KeyboardInterrupt(), SystemExit(7)])\n    def test_engine_system_finalizing_interruption_is_not_swallowed_or_published(\n        self, tmp_path: Path, exception: BaseException\n    ) -> None:\n        source = tmp_path / \"src\"\n        source.mkdir()\n        (source / \"payload\").write_bytes(b\"input\")\n        out = tmp_path / \"out.tar.gz\"\n        out.write_bytes(b\"previous archive\")\n        events: list[ProgressEvent] = []\n\n        def interrupt_finalizing(event: ProgressEvent) -> None:\n            events.append(event)\n            if event.phase == \"finalizing\":\n                raise exception\n\n        with pytest.raises(type(exception)) as caught:\n            next(\n                TarArchive().run(\n                    label=\"interrupt\",\n                    source=str(source),\n                    out=str(out),\n                    engine=\"system-tar\",\n                    progress=interrupt_finalizing,\n                )\n            )\n        assert caught.value is exception\n        assert events[-1] == ProgressEvent(\"interrupt\", \"finalizing\", None, 5)\n        assert out.read_bytes() == b\"previous archive\"\n        assert sorted(path.name for path in tmp_path.iterdir()) == [\"out.tar.gz\", \"src\"]\n\n\n## Architecture context\n\n## Code Conventions\n\n**Type hints** — modern style, no `Optional`:\n\n```python\nfrom __future__ import annotations\ndef foo(path: Path | None = None) -> list[str]: ...\n```\n\n**Imports**:\n\n- Explicit `__all__` in `__init__.py`\n- `TYPE_CHECKING` guards for type-only imports\n\n**Docstrings**: Google format\n\n**CLI pattern**: Click-based. `buvis_options` adds `--version`, `--config`, `--log-level`, `--debug`, and `--update` to every tool automatically:\n\n```python\n@click.command()\n@buvis_options\n@click.pass_context\ndef cli(ctx: click.Context) -> None:\n    settings = get_settings(ctx)\n    ...\n```\n\n**Lazy imports in CLI handlers**: import command classes inside handler functions, not at module level. This avoids pulling in optional/heavy dependencies before the user picks a subcommand:\n\n```python\n@cli.command(\"create\")\n@click.pass_context\ndef create(ctx):\n    from bim.commands.create_note.create_note import CommandCreateNote\n    ...\n```\n\n## Error Handling\n\n**Command layer** (`commands/`):\n- Return `CommandResult` for all outcomes — success and failure\n- Catch expected exceptions (e.g. `FileNotFoundError`) internally, return `CommandResult(success=False, error=str(exc))`\n- No `console.panic()` or `sys.exit()` inside command classes\n- No custom exception classes for control flow\n\n**CLI layer** (`cli.py`):\n- Inspect `CommandResult` and call `console.panic()` / `console.failure()` / `console.success()`\n- Use `console.report_result()` for standardized output\n- Catch `ImportError` for optional deps, call `console.require_import()`\n- Catch `FatalError` for unrecoverable infrastructure failures\n\n**Click argument validation**:\n- Avoid parse-time validators that short-circuit before the callback (`click.Path(exists=True)`, `IntRange`, custom `ParamType.convert` that raises). They emit Click's default `Usage: ... Error: ...` formatting and bypass the buvis console.\n- Validate inside the callback instead: `if not path.is_file(): console.panic(f\"file not found: {path}\"); return`.\n- `click.Choice` is the exception — its parse-time error lists the valid values, which is more useful than a rewritten message.\n\n**Console methods**:\n- Fatal (exit): `console.panic(msg)` — prints + exits with code 1\n- Recoverable: `console.failure(msg)` — prints, continues\n- Status: `console.success()`, `console.warning()`, `console.info()`\n- All user-facing output must route through `console`. No `print()`, `sys.stdout.write()`, `sys.stderr.write()`, `click.echo()`, `click.secho()`, or the Python logging module. Plain writes bypass the buvis prefix markers (`✘`, `✓`, etc.) and become indistinguishable from stray output, which is what makes a missed `console.panic` look like a print statement to the user.\n- The one sanctioned exception is the `dot filter` clean/smudge plumbing, which writes git's blob payload as raw bytes on stdout and at most one error line on stderr, because git owns both streams and a console marker would corrupt the payload (discovery R12).\n- Never let raw exceptions (stack traces) reach the user.\n\n## Invariants (evolution guardrails)\n\nThese encode the failure classes surfaced by the 2026-07-09 evolution assessment (`docs/dev/project-management/reviews/evolution-assessment-2026-07-09.md`). Each is either **HOLDS** (enforce it) or a **GAP** (a tracked PRD is closing it — write new code to the target state, not the current one).\n\n- **Atomic persistence** — never persist a note, state file, or config with a bare `Path.write_text`/`open(...,\"w\")`. Use `pybase.filesystem.atomic_write` (tempfile + fsync + `os.replace`). Truncate-then-write loses data on crash/ENOSPC. *HOLDS for the library and note/updater write paths (00041) — keep it, except `ConfigWriter.write` (`configuration/config_writer.py`), which still does a bare `write_text` — deliberately out of scope for 00041. GAP → pidash was closed by retiring pidash (00071); autopilot-state durability now lives in the buvis home repo (tracon/statectl), not gems.*\n- **Confine request-derived paths** — any filesystem path built from an HTTP request / external input must be `resolve()`d and asserted under an allowed root before read/write/delete/open. Network-facing servers must have auth + `TrustedHostMiddleware`. *HOLDS (00042) — bim serve confines request paths via `confine_path` (403 outside the vault/archive roots), mints a startup token required as `X-Buvis-Token`, installs `TrustedHostMiddleware`, and warns on a non-loopback bind (`commands/serve/_security.py`). Keep it.*\n- **The library stays interface-agnostic** — `src/lib/buvis/pybase/` must not import a UI framework at module import time or emit output outside the console adapter. No import-time Click monkey-patching, no `sys.exit`/`click.echo`/`print` in lib code. A TUI/API/WebUI process must be able to `import` settings without pulling Click. *HOLDS (00052) — keep it.*\n- **One action, one implementation across interfaces** — CLI/TUI/API/WebUI adapters must drive the same command class / use case through the composition root and return `CommandResult`; do not reimplement business logic per interface (dot's TUI is the anti-pattern; bim's serve action registry is the exemplar). *HOLDS (00051 design → 00053/00054) — the all-interface seam design (00051) is realized: dot's git ops unified behind `DotGitService` (00053) and bim's serve/TUI converged on the shared action registry (00054). Keep it.*\n- **Claim/lifecycle release on any exit** — resource claims and locks release in `finally` (or catch `BaseException`), never only `except Exception`; `KeyboardInterrupt` must not leak a claim. *HOLDS (00044) — the bim doc claim/dedup pipeline releases claims and locks in `finally` (`commands/doc/shared/`); keep it.*\n- **`CommandResult` discipline** — commands return `CommandResult`; the CLI/adapter layer renders it (`console.report_result`) and maps exit/HTTP status. No `sys.exit`/`console.panic` inside command classes. *HOLDS in `src/tools/*/commands/**` — keep it.*\n- **Clean-architecture layering + tool isolation** — zettel `domain → application → infrastructure → integrations` one-directional; no cross-tool imports; no `src/lib → src/tools`. *HOLDS — keep it.*\n\n\nRelevant reviewed API contracts (not acceptance criteria):\n\nKeep the existing protocol-compatible signature:\n\n```python\ndef TarArchive.run(self: TarArchive, **kwargs: object) -> Iterator[StepResult]: ...\n\ndef _emit_progress(\n    progress: Callable[[ProgressEvent], None] | None,\n    event: ProgressEvent,\n) -> None: ...\n\ndef TarArchive._archive_result(\n    label: str, arcbase: Path, out: Path, walk: WalkResult, engine: str, *,\n    cancel: threading.Event | None = None,\n    progress: Callable[[ProgressEvent], None] | None = None,\n) -> StepResult: ...\n\ndef _write_archive(\n    out: Path, arcbase: Path, files: Iterable[Path], *,\n    cancel: threading.Event | None = None,\n    on_bytes: Callable[[int], None] | None = None,\n    on_finalize: Callable[[], None] | None = None,\n) -> None: ...\n\ndef _write_archive_system_tar(\n    out: Path, arcbase: Path, files: Iterable[Path], *,\n    cancel: threading.Event | None = None,\n    on_finalize: Callable[[], None] | None = None,\n) -> str | None: ...\n```\n\n`TarArchive.run` accepts the runtime kwarg `progress: Callable[[ProgressEvent], None] | None`; parse it from `kwargs`, then pass it through the existing validated-run path. Do not add it to `TarArchive.inputs`. `_emit_progress` calls a non-None callback and swallows ordinary `Exception`; it does not swallow `KeyboardInterrupt`, `SystemExit`, `GeneratorExit` or other `BaseException`. Genuine interruption must retain the established cancellation/cleanup behavior. The runner applies the same exception policy to consumer callbacks.\n\nFor a real validated run, emit `ProgressEvent(label, \"scanning\", None, None)` immediately before `_walk_tree` or `_select_items`. Invalid inputs, a missing source and preflight rejection do not enter a walk and need no fabricated activity. A bundle which becomes a skip during selection can end after scanning. For `dry_run=True`, disable the emitter before either walk and never call `progress`, including