82: src/\\n583: ├── lib/buvis/pybase/           # shared library (namespace pkg: no buvis/__init__.py)\\n584: │   ├── adapters/               # jira, console, config adapters\\n585: │   ├── configuration/          # settings/config helpers\\n586: │   ├── filesystem/             # file utilities\\n587: │   ├── formatting/             # output formatting\\n588: │   └── zettel/                 # zettel subsystem\\n589: │       ├── domain/             # entities, services, interfaces, value objects\\n590: │       ├── application/        # use cases\\n591: │       ├── infrastructure/     # formatters, repositories, file parsers\\n592: │       └── integrations/       # jira assemblers\\n593: └── tools/\\n594:     ├── bim/                    # BUVIS InfoMesh CLI (zettel integration)\\n595:     ├── dot/                    # dotfiles manager\\n596:     ├── fctracker/              # foreign currency tracker\\n597:     ├── fren/                   # file renamer toolkit\\n598:     ├── morph/                  # file conversion toolkit\\n599:     ├── muc/                    # music collection tools\\n600:     ├── netscan/                # network scanning tools\\n601:     ├── outlookctl/             # Outlook CLI\\n602:     ├── pinger/                 # ICMP ping utilities\\n603:     ├── puc/                    # photo utility collection\\n604:     ├── readerctl/              # Readwise Reader CLI\\n605:     ├── sysup/                  # system update tools\\nFILE src/tools/backup/cli.py lines 1-65\\n1: from __future__ import annotations\\n2: \\n3: from typing import TYPE_CHECKING\\n4: \\n5: import click\\n6: from buvis.pybase.adapters import console\\n7: from buvis.pybase.configuration import buvis_options\\n8: from buvis.pybase.result import FatalError\\n9: \\n10: from backup.settings import BackupSettings\\n11: \\n12: if TYPE_CHECKING:\\n13:     from collections.abc import Callable, Iterable\\n14: \\n15:     from backup.config import BackupConfig, BackupInstance\\n16:     from backup.step_result import StepResult\\n17: \\n18: \\n19: def _report_step(step: StepResult) -> None:\\n20:     if step.skipped:\\n21:         console.warning(step.message or f\\\"{step.label} skipped\\\")\\n22:     elif step.success:\\n23:         console.success(step.message or f\\\"{step.label} archived\\\")\\n24:     else:\\n25:         message = f\\\"{step.label} cancelled\\\" if step.message == \\\"cancelled\\\" else step.message\\n26:         console.failure(message or f\\\"{step.label} failed\\\")\\n27: \\n28: \\n29: def _report_steps(\\n30:     steps: Iterable[StepResult], *, dry_run: bool = False, on_interrupt: Callable[[], None] | None = None\\n31: ) -> bool:\\n32:     \\\"\\\"\\\"Render every outcome, retrying interrupted output while draining workers.\\n33: \\n34:     Return whether any step failed so the caller exits nonzero and cron sees a\\n35:     failed backup.\\n36:     \\\"\\\"\\\"\\n37:     archived = skipped = failed = 0\\n38:     iterator = iter(steps)\\n39:     pending = None\\n40:     while True:\\n41:         try:\\n42:             if pending is None:\\n43:                 pending = next(iterator)\\n44:             _report_step(pending)\\n45:             if not pending.success:\\n46:                 failed += 1\\n47:             elif pending.skipped:\\n48:                 skipped += 1\\n49:             else:\\n50:                 archived += 1\\n51:             pending = None\\n52:         except StopIteration:\\n53:             break\\n54:         except KeyboardInterrupt:\\n55:             if on_interrupt is None:\\n56:                 raise\\n57:             on_interrupt()\\n58:     verb = \\\"previewed\\\" if dry_run else \\\"archived\\\"\\n59:     while True:\\n60:         try:\\n61:             console.info(f\\\"{verb} {archived}, skipped {skipped}, failed {failed}\\\")\\n62:             break\\n63:         except KeyboardInterrupt:\\n64:             if on_interrupt is None:\\n65:                 raise\\nFILE src/tools/backup/cli.py lines 223-335\\n223: def _run_plan(\\n224:     cfg: BackupConfig, plan: list[tuple[str, BackupInstance]], *, dry_run: bool, plan_only: bool, jobs: int = 3\\n225: ) -> bool:\\n226:     \\\"\\\"\\\"Render the selected plan or drain its run, preserving interruption cleanup.\\n227: \\n228:     Return whether the plan or run failed so the caller exits nonzero and cron\\n229:     sees a failed backup.\\n230:     \\\"\\\"\\\"\\n231:     from backup.runner import Runner\\n232: \\n233:     try:\\n234:         runner = Runner(cfg, dry_run=dry_run, jobs=jobs)\\n235:         if plan_only:\\n236:             entries = runner.plan(plan)\\n237:             for entry in entries:\\n238:                 message = f\\\"{entry.label}  {entry.status}  {entry.source} -> {entry.out}\\\"\\n239:                 if entry.reason:\\n240:                     message += f\\\"  ({entry.reason})\\\"\\n241:                 if entry.replaces:\\n242:                     message += \\\"  [replaces existing]\\\"\\n243:                 console.info(message)\\n244:             return any(entry.status == \\\"fail\\\" for entry in entries)\\n245:         steps = runner.run(plan)\\n246:         try:\\n247:             failed = _report_steps(steps, dry_run=dry_run, on_interrupt=runner.request_cancel)\\n248:         finally:\\n249:             steps.close()\\n250:         if runner.interrupted:\\n251:             while True:\\n252:                 try:\\n253:                     names = \\\", \\\".join(runner.cancelled_names) or \\\"no unfinished instances\\\"\\n254:                     console.failure(\\\"interrupted: \\\" + names)\\n255:                     break\\n256:                 except KeyboardInterrupt:\\n257:                     runner.request_cancel()\\n258:             raise SystemExit(130)\\n259:         return failed\\n260:     except FatalError as exc:\\n261:         console.panic(str(exc))\\n262:         return True  # unreachable: panic exits, but keeps the type honest\\n263: \\n264: \\n265: @click.command(help=\\\"Run configured backup archives\\\")\\n266: @click.option(\\\"--only\\\", multiple=True, help=\\\"Run only these instance names (comma-separated or repeated).\\\")\\n267: @click.option(\\\"--tag\\\", \\\"tags\\\", multiple=True, help=\\\"Run only instances carrying one of these tags.\\\")\\n268: @click.option(\\\"--list\\\", \\\"list_plan\\\", is_flag=True, help=\\\"Print the configured instances and exit.\\\")\\n269: @click.option(\\\"--plan\\\", \\\"plan_only\\\", is_flag=True, help=\\\"Print the selected archive plan without walking sources.\\\")\\n270: @click.option(\\\"--dry-run\\\", is_flag=True, help=\\\"Walk and report what would be archived without writing it.\\\")\\n271: @click.option(\\\"--jobs\\\", type=int, default=3, show_default=True, help=\\\"Run at most this many archive instances at once.\\\")\\n272: @click.option(\\\"--source\\\", default=\\\"\\\", help=\\\"Override the single selected instance's source for this run.\\\")\\n273: @click.option(\\\"--out\\\", default=\\\"\\\", help=\\\"Override the single selected instance's out path for this run.\\\")\\n274: @click.option(\\n275:     \\\"--show-excludes\\\",\\n276:     \\\"show_excludes\\\",\\n277:     default=\\\"\\\",\\n278:     help=\\\"Print an instance's resolved exclude set and exit (read-only).\\\",\\n279: )\\n280: @click.option(\\\"--for\\\", \\\"for_path\\\", default=\\\"\\\", help=\\\"Resolve .bkpignore rules under this path for --show-excludes.\\\")\\n281: @buvis_options(settings_class=BackupSettings)\\n282: @click.pass_context\\n283: def cli(  # noqa: PLR0917  # Click binds one callback arg per CLI option\\n284:     ctx: click.Context,\\n285:     only: tuple[str, ...],\\n286:     tags: tuple[str, ...],\\n287:     list_plan: bool,\\n288:     plan_only: bool,\\n289:     dry_run: bool,\\n290:     jobs: int,\\n291:     source: str,\\n292:     out: str,\\n293:     show_excludes: str,\\n294:     for_path: str,\\n295: ) -> None:\\n296:     from backup.config import applicable_instances\\n297: \\n298:     if jobs < 1:\\n299:         console.failure(\\\"--jobs must be at least 1\\\")\\n300:         raise SystemExit(1)\\n301:     if plan_only and dry_run:\\n302:         console.failure(\\\"--plan and --dry-run are mutually exclusive\\\")\\n303:         raise SystemExit(1)\\n304:     # --for only qualifies --show-excludes; reject it before a real backup runs.\\n305:     if for_path and not show_excludes:\\n306:         console.failure(\\\"--for requires --show-excludes\\\")\\n307:         raise SystemExit(1)\\n308: \\n309:     cfg = _load_config(ctx)\\n310:     if cfg is None:\\n311:         return\\n312:     if show_excludes:\\n313:         failed = _show_excludes(cfg, show_excludes, for_path)\\n314:         if failed:\\n315:             raise SystemExit(1)\\n316:         return\\n317: \\n318:     plan = applicable_instances(cfg)\\n319:     plan, unknown_only = _select_plan(cfg, plan, only, tags)\\n320: \\n321:     if list_plan:\\n322:         _list_instances(plan)\\n323:         if unknown_only:\\n324:             raise SystemExit(1)\\n325:         return\\n326: \\n327:     plan = _override_selected(plan, source, out)\\n328:     any_failed = _run_plan(cfg, plan, dry_run=dry_run, plan_only=plan_only, jobs=jobs)\\n329:     # Unknown --only names must fail rather than silently omit backup work.\\n330:     if any_failed or unknown_only:\\n331:         raise SystemExit(1)\\n332: \\n333: \\n334: if __name__ == \\\"__main__\\\":\\n335:     cli()\\nFILE CHANGELOG.md\\n# Changelog\\n\\nAll notable changes to this project will be documented in this file.\\n\\nThe format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),\\nand this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).\\n\\n## [Unreleased]\\n\\n### Added\\n\\n- **backup**: the runner delivers bounded, cancellation-aware progress and idle ticks on the calling thread before terminal results.\\n- **backup**: archive engines report scanning, archiving and finalizing progress; Python archives include throttled input byte counts, and consumer errors do not stop backups.\\n- **backup**: immutable `ProgressEvent` records carry an instance label, phase and optional input byte counts.\\n- **backup**: `--jobs` controls concurrent archive instances (default three); cancellation stops new work, joins workers, stops tar and cleans temporary files while preserving completed results and backups; interruption exits with status 130.\\n- **backup**: `--plan` previews metadata-only run/skip/fail decisions, reasons and existing-output replacement markers; selected outputs share one timestamp and colliding paths are rejected before plan, run or dry-run execution.\\n- **backup**: optional `items` bundle literal source-relative files and directories into one archive, preserving empty directories and symlinks while applying inherited exclusions and `.bkpignore` rules.\\n- **backup**: per-instance `inherit_excludes`, `exclude_remove` and `exclude_add` control inherited exclusions for archives and `--show-excludes`.\\n\\n### Changed\\n\\n- **backup**: missing sources and bundles with no surviving members now warn and skip without touching previous archives; each run reports archived or previewed, skipped, and failed step counts. Existing non-directory sources and unreadable selected files still fail.\\n\\n### Fixed\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19912-c8f8-7b20-a4a1-eba5c0157559","create_time":1793569530.417092}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
