+{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 -c \\\"from pathlib import Path; print(Path('src/tools/backup/capabilities/tar_archive.py').read_text())\\\"\"","aggregated_output":"from __future__ import annotations\n\nimport contextlib\nimport os\nimport shutil\nimport stat\nimport subprocess\nimport tarfile\nimport tempfile\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import TYPE_CHECKING, cast\n\nfrom backup.shared.bkpignore import (\n    BKPIGNORE_FILENAME,\n    ExcludeState,\n    state_for_directory,\n)\nfrom backup.step_result import ArchiveMeta, PlanEntry, StepResult\n\nif TYPE_CHECKING:\n    import threading\n    from collections.abc import Iterable, Iterator, Mapping\n\n__all__ = [\"ArchiveCancelled\", \"TarArchive\", \"WalkResult\"]\n\n_ARCHIVE_MODE = 0o600\n_ENGINE_PYTHON = \"python-tarfile\"\n_ENGINE_SYSTEM_TAR = \"system-tar\"\n\n\nclass ArchiveCancelled(Exception):\n    \"\"\"Archive creation stopped before publication.\"\"\"\n\n\ndef _check_cancel(cancel: threading.Event | None) -> None:\n    if cancel is not None and cancel.is_set():\n        raise ArchiveCancelled\n\n\nclass WalkResult:\n    \"\"\"The outcome of walking + filtering a source tree, before any archive.\n\n    ``files`` is the ordered list of archive MEMBERS as absolute paths:\n    surviving directories first (parent-first, so a restore recreates the tree\n    including empty dirs), then regular files, then symlinks (each archived as\n    the link itself, not followed, matching the former tar backup). ``file_count``\n    counts only the regular files (not dirs or symlinks) and ``total_bytes`` sums\n    their input sizes (a symlink/dir contributes 0). ``applied`` lists the\n    ``.bkpignore`` rules that fired anywhere in the tree (for dry-run reporting).\n    \"\"\"\n\n    def __init__(\n        self: WalkResult,\n        files: list[Path],\n        total_bytes: int,\n        applied: list[str],\n        file_count: int,\n    ) -> None:\n        self.files = files\n        self.total_bytes = total_bytes\n        self.applied = applied\n        self._file_count = file_count\n\n    @property\n    def file_count(self: WalkResult) -> int:\n        return self._file_count\n\n\nclass TarArchive:\n    \"\"\"Tar a source tree into a compressed, ``chmod 600``, atomically-written archive.\n\n    File selection is owned here: it :func:`os.walk`s ``source`` top-down,\n    layering each directory's ``.bkpignore`` rules onto the exclude state\n    inherited from its ancestors (so ``!target`` un-ignores are path-scoped to\n    the file's own subtree), and adds surviving files to a\n    ``tarfile.open(mode=\"w:gz\")``. The archive is streamed to a sibling temp\n    file, ``fsync``ed, ``chmod 600``ed, then ``os.replace``d into ``out`` — so a\n    crash or ENOSPC never leaves a partial ``.tar.gz`` at the final path.\n    \"\"\"\n\n    @property\n    def inputs(self: TarArchive) -> Mapping[str, object]:\n        return {\"source\": \"\", \"out\": \"\", \"engine\": _ENGINE_PYTHON, \"items\": None}\n\n    def plan(self: TarArchive, **kwargs: object) -> PlanEntry:\n        label, engine, source_raw, out_raw, now = _parse_inputs(kwargs)\n        message = _missing_input(source_raw, out_raw)\n        if message:\n            source_text = str(os.path.normpath(Path(source_raw).expanduser())) if source_raw else \"\"\n            out_text = _expand_stamp(out_raw, now) if out_raw else \"\"\n            return PlanEntry(label, source_text, out_text, \"fail\", message, False)\n        source, out = _resolve_paths(source_raw, out_raw, now)\n        replaces = out.exists()\n        status = \"run\"\n        reason = \"\"\n\n        if engine not in (_ENGINE_PYTHON, _ENGINE_SYSTEM_TAR):\n            status = \"fail\"\n            reason = f\"unknown engine '{engine}'; expected {_ENGINE_PYTHON} or {_ENGINE_SYSTEM_TAR}\"\n        elif not source.is_dir():\n            missing = not source.exists()\n            status = \"skip\" if missing else \"fail\"\n            reason = f\"{'source not found' if missing else 'source is not a directory'}: {source}\"\n        else:\n            containment = _reject_out_inside_source(label, source, out)\n            if containment is not None:\n                status = \"fail\"\n                reason = containment.message\n            elif \"items\" in kwargs:\n                try:\n                    selected = _normalize_items(source, _as_str_tuple(kwargs[\"items\"]))\n                except ValueError as exc:\n                    status = \"fail\"\n                    reason = str(exc)\n                else:\n                    if not any(os.path.lexists(source / item) for item in selected):\n                        status = \"skip\"\n                        reason = \"no selected items to archive\"\n\n        return PlanEntry(label, str(source), str(out), status, reason, replaces)\n\n    def run(self: TarArchive, **kwargs: object) -> Iterator[StepResult]:\n        _check_cancel(cast(\"threading.Event | None\", kwargs.get(\"cancel\")))\n        label, engine, source_raw, out_raw, now = _parse_inputs(kwargs)\n        message = _missing_input(source_raw, out_raw)\n        if message:\n            yield StepResult(label, success=False, message=message)\n            return\n\n        source, out = _resolve_paths(source_raw, out_raw, now)\n\n        if engine not in (_ENGINE_PYTHON, _ENGINE_SYSTEM_TAR):\n            yield StepResult(\n                label,\n                success=False,\n                message=f\"unknown engine '{engine}'; expected {_ENGINE_PYTHON} or {_ENGINE_SYSTEM_TAR}\",\n            )\n            return\n\n        if not source.is_dir():\n            missing_source = not source.exists()\n            reason = \"source not found\" if missing_source else \"source is not a directory\"\n            yield StepResult(label, success=missing_source, message=f\"{reason}: {source}\", skipped=missing_source)\n            return\n\n        containment = _reject_out_inside_source(label, source, out)\n        if containment is not None:\n            yield containment\n            return\n\n        yield from self._run_validated(label, engine, source, out, kwargs)\n\n    def _run_validated(\n        self: TarArchive,\n        label: str,\n        engine: str,\n        source: Path,\n        out: Path,\n        kwargs: dict[str, object],\n    ) -> Iterator[StepResult]:\n        cancel = cast(\"threading.Event | None\", kwargs.get(\"cancel\"))\n        _check_cancel(cancel)\n        dry_run = bool(kwargs.get(\"dry_run\", False))\n        base_state = ExcludeState(base_excludes=frozenset(_as_str_tuple(kwargs.get(\"excludes\", ()))))\n        missing: list[str] = []\n        bundle = \"items\" in kwargs\n        if bundle:\n            try:\n                selected = _normalize_items(source, _as_str_tuple(kwargs[\"items\"]))\n            except ValueError as exc:\n                yield StepResult(label, success=False, message=str(exc))\n                return\n            walk, missing = _select_items(source, base_state, selected)\n            _check_cancel(cancel)\n            if not walk.files:\n                message = \"no selected items to archive\"\n                if missing:\n                    message += f\"; missing items: {', '.join(missing)}\"\n                yield StepResult(label, success=True, message=message, skipped=True)\n                return\n        else:\n            walk = _walk_tree(source, base_state)\n            _check_cancel(cancel)\n\n        if dry_run:\n            result = self._dry_run_result(label, out, walk)\n        else:\n            result = self._archive_result(label, source if bundle else source.parent, out, walk, engine, cancel=cancel)\n        if missing:\n            result.message += f\"; missing items: {', '.join(missing)}\"\n        yield result\n\n    @staticmethod\n    def _dry_run_result(label: str, out: Path, walk: WalkResult) -> StepResult:\n        applied = \", \".join(walk.applied) if walk.applied else \"none\"\n        message = (\n            f\"would archive {walk.file_count} files ({walk.total_bytes} bytes) \"\n            f\"-> {out}; .bkpignore rules applied: {applied}\"\n        )\n        return StepResult(\n            label,\n            success=True,\n            message=message,\n            archive=ArchiveMeta(out_path=str(out), file_count=walk.file_count, total_bytes=walk.total_bytes),\n        )\n\n    @staticmethod\n    def _archive_result(  # noqa: PLR0913 — retain archive context plus keyword-only cancellation\n        label: str, arcbase: Path, out: Path, walk: WalkResult, engine: str, *, cancel: threading.Event | None = None\n    ) -> StepResult:\n        _check_cancel(cancel)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        note = \"\"\n        if engine == _ENGINE_SYSTEM_TAR:\n            fallback = _write_archive_system_tar(out, arcbase, walk.files, cancel=cancel)\n            if fallback is not None:\n                _write_archive(out, arcbase, walk.files, cancel=cancel)\n                note = f\" (system-tar unavailable: {fallback}; used python engine)\"\n        else:\n            _write_archive(out, arcbase, walk.files, cancel=cancel)\n        size = out.stat().st_size\n        return StepResult(\n            label,\n            success=True,\n            message=(\n                f\"archived {walk.file_count} files -> {out} ({walk.total_bytes} bytes in, {size} bytes on disk){note}\"\n            ),\n            archive=ArchiveMeta(out_path=str(out), file_count=walk.file_count, total_bytes=walk.total_bytes),\n        )\n\n\ndef _reject_out_inside_source(label: str, source: Path, out: Path) -> StepResult | None:\n    \"\"\"Reject an ``out`` path that lands inside the ``source`` tree.\n\n    An ``out`` under ``source`` makes each run re-archive the previous run's\n    archive (unbounded recursive growth). ``out`` may not exist yet, so its\n    PARENT is resolved (which does exist — a stamp only expands the basename) and\n    the name rejoined, giving a real absolute path to test for containment\n    against the resolved source. Returns a failed :class:`StepResult` when ``out``\n    is inside ``source`` (the caller yields it and returns before walking),\n    otherwise ``None``.\n    \"\"\"\n    source_resolved = source.resolve()\n    out_resolved = out.parent.resolve() / out.name\n    if out_resolved == source_resolved or source_resolved in out_resolved.parents:\n        return StepResult(\n            label,\n            success=False,\n            message=(f\"out path {out} is inside source {source}; choose an out path outside the backup source\"),\n        )\n    return None\n\n\ndef _normalize_items(source: Path, items: tuple[str, ...]) -> list[Path]:\n    \"\"\"Validate literal item paths and remove duplicate selected subtrees.\"\"\"\n    if not items:\n        raise ValueError(\"items must not be empty\")\n    selected: list[Path] = []\n    for item in items:\n        relative = Path(os.path.normpath(item))\n        if not item or relative.is_absolute() or relative == Path(\".\") or relative.parts[0].startswith(\"..\"):\n            raise ValueError(f\"invalid item '{item}': must be a relative path inside the source\")\n        for parent in reversed(relative.parents):\n            if parent != Path(\".\") and (source / parent).is_symlink():\n                raise ValueError(f\"item '{item}' passes through symlink '{parent.as_posix()}'\")\n        if relative not in selected and not any(parent in selected for parent in relative.parents):\n            selected = [path for path in selected if relative not in path.parents]\n            selected.append(relative)\n    return selected\n\n\ndef _select_items(source: Path, base_state: ExcludeState, selected: list[Path]) -> tuple[WalkResult, list[str]]:\n    \"\"\"Select bundle members using source-relative excludes and ancestor rules.\"\"\"\n    files: list[Path] = []\n    missing: list[str] = []\n    total_bytes = file_count = 0\n    states: dict[str, ExcludeState] = {str(source): state_for_directory(source, base_state)}\n    applied: list[str] = []\n    for relative in selected:\n        path = source / relative\n        if not os.path.lexists(path):\n            missing.append(relative.as_posix())\n            continue\n        metadata = path.lstat()\n        state = states[str(source)]\n        for index, component in enumerate(relative.parts):\n            ancestor = source.joinpath(*relative.parts[: index + 1])\n            relpath = ancestor.relative_to(source).as_posix()\n            if state.is_excluded(component, relpath):\n                break\n            if index < len(relative.parts) - 1:\n                state = state_for_directory(ancestor, state)\n                states[str(ancestor)] = state\n                continue\n            if stat.S_ISDIR(metadata.st_mode):\n                subtree = _walk_tree(path, state, root=source)\n                files.extend(subtree.files)\n                file_count += subtree.file_count\n                total_bytes += subtree.total_bytes\n                applied.extend(subtree.applied)\n            elif component != BKPIGNORE_FILENAME:\n                if stat.S_ISREG(metadata.st_mode):\n                    file_count += 1\n                    total_bytes += metadata.st_size\n                    files.append(path)\n                elif stat.S_ISLNK(metadata.st_mode):\n                    files.append(path)\n    rules = list(dict.fromkeys([*_collect_applied(states), *applied]))\n    return WalkResult(files, total_bytes, rules, file_count), missing\n\n\ndef _walk_tree(source: Path, base_state: ExcludeState, *, root: Path | None = None) -> WalkResult:\n    \"\"\"Walk ``source`` top-down, applying global excludes + path-scoped ``.bkpignore``.\n\n    The exclude state at each directory is the ancestors' state layered with\n    that directory's own ``.bkpignore`` (if any). Excluded directories are\n    pruned from further descent; surviving regular files are collected.\n    \"\"\"\n    files: list[Path] = []\n    symlinks: list[Path] = []\n    dirs: list[Path] = []\n    total_bytes = 0\n    if root is None:\n        root = source\n    states: dict[str, ExcludeState] = {str(source): state_for_directory(source, base_state)}\n\n    for dirpath, dirnames, filenames in os.walk(source, onerror=_raise_walk_error):\n        state = states[dirpath]\n\n        # Record this surviving directory (the source root, then every descended\n        # kept subdir) so it is archived non-recursively — otherwise an empty\n        # directory, and an empty source tree's own `src/` entry, would vanish on\n        # restore, unlike the former `tar -C ... source`.\n        dirs.append(Path(dirpath))\n\n        kept_dirs: list[str] = []\n        for dirname in dirnames:\n            child = os.path.join(dirpath, dirname)\n            relpath = os.path.relpath(child, root).replace(os.sep, \"/\")\n            if state.is_excluded(dirname, relpath):\n                continue\n            # A directory symlink: os.walk (followlinks=False) will not descend\n            # it, and we must NOT read <link>/.bkpignore (it may point outside\n            # the source tree) — so it stays out of kept_dirs. But the link\n            # ITSELF is archived as a non-recursive symlink member, so restoring\n            # preserves it (the former tar backup kept symlinks). tarfile /\n            # system tar store a symlink as a link without following it.\n            if os.path.islink(child):\n                symlinks.append(Path(child))\n                continue\n            states[child] = state_for_directory(Path(child), state)\n            kept_dirs.append(dirname)\n        dirnames[:] = kept_dirs\n\n        for filename in filenames:\n            if filename == BKPIGNORE_FILENAME:\n                continue\n            file_path = Path(dirpath) / filename\n            relpath = os.path.relpath(file_path, root).replace(os.sep, \"/\")\n            if state.is_excluded(filename, relpath):\n                continue\n            # Archive a symlink as the link itself (not its target), matching the\n            # former tar backup — but never stat() it (that follows the link and\n            # a broken link would raise); a link contributes 0 input bytes.\n            if file_path.is_symlink():\n                symlinks.append(file_path)\n                continue\n            if not file_path.is_file():\n                continue\n            files.append(file_path)\n            # No suppression: a file we selected but cannot stat is a real error\n            # for an archiver, not a 0-byte undercount. The runner turns the\n            # propagated OSError into a failed step.\n            total_bytes += file_path.stat().st_size\n\n    return WalkResult(\n        files=[*dirs, *files, *symlinks],\n        total_bytes=total_bytes,\n        applied=_collect_applied(states),\n        file_count=len(files),\n    )\n\n\ndef _raise_walk_error(error: OSError) -> None:\n    \"\"\"``os.walk`` ``onerror`` callback that re-raises a directory-scan error.\n\n    Without it ``os.walk`` silently swallows an unreadable subtree, yielding a\n    partial archive reported as success. Re-raising lets the runner's\n    ``except Exception -> StepResult(success=False)`` turn it into a failed step.\n    \"\"\"\n    raise error\n\n\ndef _collect_applied(states: dict[str, ExcludeState]) -> list[str]:\n    \"\"\"Gather every distinct ``.bkpignore`` rule that fired anywhere in the tree.\"\"\"\n    seen: list[str] = []\n    for state in states.values():\n        for rule in state.applied:\n            if rule not in seen:\n                seen.append(rule)\n    return seen\n\n\ndef _write_archive(out: Path, arcbase: Path, files: Iterable[Path], *, cancel: threading.Event | None = None) -> None:\n    \"\"\"Stream a ``w:gz`` tarball of ``files`` to ``out`` atomically, ``chmod 600``.\n\n    Replicates ``pybase.filesystem.atomic_write``'s tempfile + fsync +\n    ``os.replace`` guarantee, but streams tar output straight into the temp file\n    (a large tarball must never be built in memory, which the byte-oriented\n    ``atomic_write_bytes`` would require). Archive names are stored relative to\n    ``arcbase``: the source's parent for whole trees, or the source itself for\n    selected items.\n    \"\"\"\n    _check_cancel(cancel)\n    fd, tmp_name = tempfile.mkstemp(prefix=out.name + \".\", suffix=\".tmp\", dir=str(out.parent))\n    tmp_path = Path(tmp_name)\n    try:\n        with os.fdopen(fd, \"wb\") as raw:\n            os.fchmod(fd, _ARCHIVE_MODE)\n            with tarfile.open(fileobj=raw, mode=\"w:gz\") as tar:\n                for file_path in files:\n                    _check_cancel(cancel)\n                    arcname = file_path.relative_to(arcbase)\n                    tar.add(str(file_path), arcname=str(arcname), recursive=False)\n                _check_cancel(cancel)\n            raw.flush()\n            os.fsync(raw.fileno())\n        _check_cancel(cancel)\n        os.replace(tmp_path, out)\n    except BaseException:\n        with contextlib.suppress(OSError):\n            tmp_path.unlink(missing_ok=True)\n        raise\n\n\ndef _write_archive_system_tar(\n    out: Path, arcbase: Path, files: Iterable[Path], *, cancel: threading.Event | None = None\n) -> str | None:\n    \"\"\"Archive ``files`` via system ``tar --null -T -``, atomically, ``chmod 600``.\n\n    Python owns selection; nonrecursive, NUL-delimited paths preserve the exact\n    member list, including empty directories and filenames containing newlines.\n    ``--no-recursion`` prevents listed directories from re-adding excluded content.\n    NUL delimiting prevents filenames containing newlines from injecting members.\n    The sibling temp archive is fsynced before atomic publication.\n\n    Returns:\n        ``None`` on success, otherwise a reason for Python fallback.\n    \"\"\"\n    _check_cancel(cancel)\n    tar_bin = shutil.which(\"tar\")\n    if tar_bin is None:\n        return \"tar not found on PATH\"\n\n    fd, tmp_name = tempfile.mkstemp(prefix=out.name + \".\", suffix=\".tmp\", dir=str(out.parent))\n    os.close(fd)\n    tmp_path = Path(tmp_name)\n    published = False\n    try:\n        filelist = b\"\".join(os.fsencode(file_path.relative_to(arcbase)) + b\"\\0\" for file_path in files)\n        _check_cancel(cancel)\n        returncode, stderr_bytes = _run_system_tar(tar_bin, arcbase, tmp_path, filelist, cancel=cancel)\n        if returncode != 0:\n            stderr = stderr_bytes.decode(\"utf-8\", \"replace\").strip().splitlines()\n            detail = stderr[-1] if stderr else f\"exit {returncode}\"\n            return f\"tar exited {returncode}: {detail}\"\n        # Match the Python engine's durability: fsync the finished temp archive\n        # before atomically swapping it into place.\n        archive_fd = os.open(str(tmp_path), os.O_RDONLY)\n        try:\n            os.fsync(archive_fd)\n        finally:\n            os.close(archive_fd)\n        os.chmod(tmp_path, _ARCHIVE_MODE)\n        _check_cancel(cancel)\n        os.replace(tmp_path, out)\n        published = True\n    except OSError as exc:\n        return f\"tar invocation failed: {exc}\"\n    finally:\n        with contextlib.suppress(OSError):\n            tmp_path.unlink(missing_ok=True)\n        if not published:\n            _check_cancel(cancel)\n    return None\n\n\ndef _run_system_tar(\n    tar_bin: str, arcbase: Path, tmp_path: Path, filelist: bytes, *, cancel: threading.Event | None\n) -> tuple[int | None, bytes]:\n    \"\"\"Run tar with cancellable communication and unconditional process cleanup.\"\"\"\n    # bsdtar (macOS) otherwise stores AppleDouble (``._name``) metadata\n    # members that the Python engine never produces; COPYFILE_DISABLE\n    # suppresses them and is a no-op for GNU tar on Linux.\n    env = {**os.environ, \"COPYFILE_DISABLE\": \"1\"}\n    process = subprocess.Popen(\n        [tar_bin, \"-C\", str(arcbase), \"--no-recursion\", \"--null\", \"-czf\", str(tmp_path), \"-T\", \"-\"],\n        stdin=subprocess.PIPE,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        env=env,\n        start_new_session=True,\n    )\n    try:\n        first_communication = True\n        while True:\n            _check_cancel(cancel)\n            try:\n                if first_communication:\n                    first_communication = False\n                    _, stderr_bytes = process.communicate(input=filelist, timeout=0.2)\n                else:\n                    _, stderr_bytes = process.communicate(timeout=0.2)\n                _check_cancel(cancel)\n                return process.returncode, stderr_bytes\n            except subprocess.TimeoutExpired:\n                continue\n    finally:\n        _cleanup_tar_process(process)\n\n\ndef _cleanup_tar_process(process: subprocess.Popen[bytes]) -> None:\n    \"\"\"Stop and reap a live tar child, then close all owned pipes.\"\"\"\n    try:\n        if process.poll() is None:\n            with contextlib.suppress(ProcessLookupError):\n                process.terminate()\n            try:\n                process.communicate(timeout=5.0)\n            except subprocess.TimeoutExpired:\n                with contextlib.suppress(ProcessLookupError):\n                    process.kill()\n                process.communicate()\n    finally:\n        for pipe in (process.stdin, process.stdout, process.stderr):\n            if pipe is not None:\n                with contextlib.suppress(OSError):\n                    pipe.close()\n\n\ndef _parse_inputs(kwargs: Mapping[str, object]) -> tuple[str, str, str, str, datetime | None]:\n    \"\"\"Parse label, engine, raw source/out and ``now``; an empty engine means the python engine.\"\"\"\n    return (\n        _require_str(kwargs, \"label\", default=\"tar-archive\"),\n        _require_str(kwargs, \"engine\", default=_ENGINE_PYTHON) or _ENGINE_PYTHON,\n        _require_str(kwargs, \"source\"),\n        _require_str(kwargs, \"out\"),\n        cast(\"datetime | None\", kwargs.get(\"now\")),\n    )\n\n\ndef _missing_input(source_raw: str, out_raw: str) -> str:\n    \"\"\"Return the missing-input message, or ``\"\"`` when both source and out are set.\"\"\"\n    if not source_raw:\n        return \"no source configured\"\n    return \"\" if out_raw else \"no out path configured\"\n\n\ndef _resolve_paths(source_raw: str, out_raw: str, now: datetime | None) -> tuple[Path, Path]:\n    # Normalize `.`/`..` LEXICALLY (os.path.normpath, not resolve()) before\n    # walking: a source like `parent/child/..` would otherwise be walked as\n    # given and produce member names like `..` / `../child` (an unsafe\n    # archive that also breaks the documented source-name prefix). normpath\n    # collapses the segments without following symlinks, so the\n    # symlink-confinement guarantee is untouched.\n    source = Path(os.path.normpath(Path(source_raw).expanduser()))\n    return source, Path(_expand_stamp(out_raw, now)).expanduser()\n\n\ndef _require_str(kwargs: Mapping[str, object], key: str, *, default: str = \"\") -> str:\n    value = kwargs.get(key, default)\n    return value if isinstance(value, str) else default\n\n\ndef _expand_stamp(pattern: str, now: datetime | None = None) -> str:\n    \"\"\"Expand ``strftime`` codes in an ``out`` pattern against the supplied or current time.\n\n    A pattern like ``git-src-%Y%m%d-%H%M%S.tar.gz`` becomes a timestamped name\n    at archive time, reproducing the wrapped script's ``date +%Y%m%d-%H%M%S``\n    behaviour. A pattern with no ``%`` codes is returned unchanged.\n    \"\"\"\n    if \"%\" not in pattern:\n        return pattern\n    return (now if now is not None else datetime.now()).strftime(pattern)\n\n\ndef _as_str_tuple(value: object) -> tuple[str, ...]:\n    if isinstance(value, (list, tuple)):\n        return tuple(str(item) for item in value)\n    return ()\n\n","exit_code":0,"status":"completed"}}
+{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 -c \\\"from pathlib import Path; print(Path('src/tools/backup/cli.py').read_text()); print(Path('src/tools/backup/capabilities/_tar_archive_engines.py').exists())\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
+{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/opt/homebrew/bin/bash -lc \"python3 -c \\\"from pathlib import Path; print(Path('src/tools/backup/cli.py').read_text()); print(Path('src/tools/backup/capabilities/_tar_archive_engines.py').exists())\\\"\"","aggregated_output":"from __future__ import annotations\n\nfrom typing import TYPE_CHECKING\n\nimport click\nfrom buvis.pybase.adapters import console\nfrom buvis.pybase.configuration import buvis_options\nfrom buvis.pybase.result import FatalError\n\nfrom backup.settings import BackupSettings\n\nif TYPE_CHECKING:\n    from collections.abc import Callable, Iterable\n\n    from backup.config import BackupConfig, BackupInstance\n    from backup.step_result import StepResult\n\n\ndef _report_step(step: StepResult) -> None:\n    if step.skipped:\n        console.warning(step.message or f\"{step.label} skipped\")\n    elif step.success:\n        console.success(step.message or f\"{step.label} archived\")\n    else:\n        message = f\"{step.label} cancelled\" if step.message == \"cancelled\" else step.message\n        console.failure(message or f\"{step.label} failed\")\n\n\ndef _report_steps(\n    steps: Iterable[StepResult], *, dry_run: bool = False, on_interrupt: Callable[[], None] | None = None\n) -> bool:\n    \"\"\"Render every outcome, retrying interrupted output while draining workers.\n\n    Return whether any step failed so the caller exits nonzero and cron sees a\n    failed backup.\n    \"\"\"\n    archived = skipped = failed = 0\n    iterator = iter(steps)\n    pending = None\n    while True:\n        try:\n            if pending is None:\n                pending = next(iterator)\n            _report_step(pending)\n            if not pending.success:\n                failed += 1\n            elif pending.skipped:\n                skipped += 1\n            else:\n                archived += 1\n            pending = None\n        except StopIteration:\n            break\n        except KeyboardInterrupt:\n            if on_interrupt is None:\n                raise\n            on_interrupt()\n    verb = \"previewed\" if dry_run else \"archived\"\n    while True:\n        try:\n            console.info(f\"{verb} {archived}, skipped {skipped}, failed {failed}\")\n            break\n        except KeyboardInterrupt:\n            if on_interrupt is None:\n                raise\n            on_interrupt()\n    return failed > 0\n\n\ndef _parse_only(only: tuple[str, ...]) -> set[str]:\n    names: set[str] = set()\n    for item in only:\n        names.update(part.strip() for part in item.split(\",\") if part.strip())\n    return names\n\n\ndef _describe(name: str, instance: BackupInstance) -> str:\n    tags = f\" [tags: {', '.join(instance.tags)}]\" if instance.tags else \"\"\n    return f\"{instance.order:>4}  {name}  (use:{instance.use}){tags}\"\n\n\ndef _apply_overrides(instance: BackupInstance, source: str, out: str) -> BackupInstance:\n    \"\"\"Return a copy of ``instance`` with ``source`` / ``out`` overridden in ``with_``.\n\n    A non-empty flag value replaces the instance's configured value for a\n    one-shot run; an empty value leaves the config value untouched (flag wins\n    over config). The frozen model is copied rather than mutated.\n    \"\"\"\n    merged = dict(instance.with_)\n    if source:\n        merged[\"source\"] = source\n    if out:\n        merged[\"out\"] = out\n    return instance.model_copy(update={\"with_\": merged})\n\n\ndef _override_selected(\n    plan: list[tuple[str, BackupInstance]], source: str, out: str\n) -> list[tuple[str, BackupInstance]]:\n    if not (source or out):\n        return plan\n    if len(plan) != 1:\n        console.failure(\n            f\"--source/--out require exactly one selected instance (via --only); {len(plan)} selected\",\n        )\n        raise SystemExit(1)\n    name, instance = plan[0]\n    return [(name, _apply_overrides(instance, source, out))]\n\n\ndef _list_instances(plan: list[tuple[str, BackupInstance]]) -> None:\n    if not plan:\n        console.info(\"no configured instances\")\n    else:\n        for name, instance in plan:\n            console.info(_describe(name, instance))\n\n\ndef _load_config(ctx: click.Context) -> BackupConfig | None:\n    from backup.config import load_config\n\n    # Honour the same --config / --config-dir the buvis_options wrapper resolved\n    # settings from, so the backup PLAN and BackupSettings come from ONE source.\n    # The wrapper publishes the raw selection on ctx.obj (None when unset); pass\n    # it through so `backup --config FILE` runs the plan from FILE and\n    # `--config-dir DIR` discovers it under DIR. (PRD 00084 closed the split that\n    # was deferred from PR #179.)\n    obj = ctx.obj or {}\n    config_dir = obj.get(\"config_dir\")\n    config_path = obj.get(\"config_path\")\n    try:\n        return load_config(config_dir=config_dir, config_path=config_path)\n    except FatalError as exc:\n        console.panic(str(exc))\n        return None\n\n\ndef _show_excludes(cfg: BackupConfig, instance_name: str, for_path: str) -> bool:\n    \"\"\"Print the resolved exclude set for ``instance_name`` under ``--for`` path.\n\n    Renders the instance exclude set (after inheritance, removals and additions)\n    and, when ``for_path`` is given, the ``.bkpignore`` add / ``!``-unignore\n    rules effective under that path — resolved with the same layering the\n    archive walk uses. Writes no archive. Without ``--for`` prints the instance\n    set only and notes that path-dependent ``.bkpignore`` rules are omitted.\n\n    Returns ``True`` on a terminal validation failure (unknown instance, or an\n    instance with no source) so the CLI layer can exit nonzero — a typo like\n    ``backup --show-excludes typo`` must not look like a successful inspection\n    to a script.\n    \"\"\"\n    from pathlib import Path\n\n    from backup.config import effective_excludes\n    from backup.shared.bkpignore import ExcludeState, resolve_state_for_path\n\n    instance = cfg.instances.get(instance_name)\n    if instance is None:\n        console.failure(f\"unknown instance '{instance_name}'\")\n        return True\n\n    excludes = effective_excludes(cfg, instance)\n    console.info(f\"resolved excludes for '{instance_name}':\")\n    for pattern in excludes:\n        console.info(f\"  {pattern}\")\n\n    if not for_path:\n        console.info(\"(.bkpignore rules omitted — path-dependent; pass --for <path> to resolve them)\")\n        return False\n\n    source_raw = instance.with_.get(\"source\")\n    if not isinstance(source_raw, str) or not source_raw:\n        console.failure(f\"instance '{instance_name}' has no source configured\")\n        return True\n\n    source = Path(source_raw).expanduser()\n    target = Path(for_path).expanduser()\n    base_state = ExcludeState(base_excludes=frozenset(excludes))\n    state = resolve_state_for_path(source, base_state, target)\n\n    console.info(f\".bkpignore rules effective under {target}:\")\n    if state.applied:\n        for rule in state.applied:\n            console.info(f\"  {rule}\")\n    else:\n        console.info(\"  none\")\n    return False\n\n\ndef _select_plan(\n    cfg: BackupConfig,\n    plan: list[tuple[str, BackupInstance]],\n    only: tuple[str, ...],\n    tags: tuple[str, ...],\n) -> tuple[list[tuple[str, BackupInstance]], bool]:\n    \"\"\"Narrow ``plan`` by ``--only`` names and ``--tag`` tags, reporting skips via console.\n\n    Returns the narrowed plan plus a flag that is ``True`` when any requested\n    ``--only`` name was unknown to the config. Valid names still run (the caller\n    executes whatever survived), but the flag lets the CLI exit nonzero so a typo\n    that leaves an empty or reduced plan cannot make a scheduled backup silently\n    do nothing (or less) while reporting success.\n    \"\"\"\n    had_unknown = False\n    only_names = _parse_only(only)\n    if only_names:\n        selected_names = {name for name, _ in plan}\n        for requested in sorted(only_names):\n            if requested not in cfg.instances:\n                console.failure(f\"unknown instance '{requested}', skipping\")\n                had_unknown = True\n            elif requested not in selected_names:\n                console.info(f\"'{requested}' is disabled, skipping\")\n        plan = [(name, instance) for name, instance in plan if name in only_names]\n\n    if tags:\n        wanted = set(tags)\n        plan = [(name, instance) for name, instance in plan if wanted & set(instance.tags)]\n\n    return plan, had_unknown\n\n\ndef _run_plan(\n    cfg: BackupConfig, plan: list[tuple[str, BackupInstance]], *, dry_run: bool, plan_only: bool, jobs: int = 3\n) -> bool:\n    \"\"\"Render the selected plan or drain its run, preserving interruption cleanup.\n\n    Return whether the plan or run failed so the caller exits nonzero and cron\n    sees a failed backup.\n    \"\"\"\n    from backup.runner import Runner\n\n    try:\n        runner = Runner(cfg, dry_run=dry_run, jobs=jobs)\n        if plan_only:\n            entries = runner.plan(plan)\n            for entry in entries:\n                message = f\"{entry.label}  {entry.status}  {entry.source} -> {entry.out}\"\n                if entry.reason:\n                    message += f\"  ({entry.reason})\"\n                if entry.replaces:\n                    message += \"  [replaces existing]\"\n                console.info(message)\n            return any(entry.status == \"fail\" for entry in entries)\n        steps = runner.run(plan)\n        try:\n            failed = _report_steps(steps, dry_run=dry_run, on_interrupt=runner.request_cancel)\n        finally:\n            steps.close()\n        if runner.interrupted:\n            while True:\n                try:\n                    names = \", \".join(runner.cancelled_names) or \"no unfinished instances\"\n                    console.failure(\"interrupted: \" + names)\n                    break\n                except KeyboardInterrupt:\n                    runner.request_cancel()\n            raise SystemExit(130)\n        return failed\n    except FatalError as exc:\n        console.panic(str(exc))\n        return True  # unreachable: panic exits, but keeps the type honest\n\n\n@click.command(help=\"Run configured backup archives\")\n@click.option(\"--only\", multiple=True, help=\"Run only these instance names (comma-separated or repeated).\")\n@click.option(\"--tag\", \"tags\", multiple=True, help=\"Run only instances carrying one of these tags.\")\n@click.option(\"--list\", \"list_plan\", is_flag=True, help=\"Print the configured instances and exit.\")\n@click.option(\"--plan\", \"plan_only\", is_flag=True, help=\"Print the selected archive plan without walking sources.\")\n@click.option(\"--dry-run\", is_flag=True, help=\"Walk and report what would be archived without writing it.\")\n@click.option(\"--jobs\", type=int, default=3, show_default=True, help=\"Run at most this many archive instances at once.\")\n@click.option(\"--source\", default=\"\", help=\"Override the single selected instance's source for this run.\")\n@click.option(\"--out\", default=\"\", help=\"Override the single selected instance's out path for this run.\")\n@click.option(\n    \"--show-excludes\",\n    \"show_excludes\",\n    default=\"\",\n    help=\"Print an instance's resolved exclude set and exit (read-only).\",\n)\n@click.option(\"--for\", \"for_path\", default=\"\", help=\"Resolve .bkpignore rules under this path for --show-excludes.\")\n@buvis_options(settings_class=BackupSettings)\n@click.pass_context\ndef cli(  # noqa: PLR0917  # Click binds one callback arg per CLI option\n    ctx: click.Context,\n    only: tuple[str, ...],\n    tags: tuple[str, ...],\n    list_plan: bool,\n    plan_only: bool,\n    dry_run: bool,\n    jobs: int,\n    source: str,\n    out: str,\n    show_excludes: str,\n    for_path: str,\n) -> None:\n    from backup.config import applicable_instances\n\n    if jobs < 1:\n        console.failure(\"--jobs must be at least 1\")\n        raise SystemExit(1)\n    if plan_only and dry_run:\n        console.failure(\"--plan and --dry-run are mutually exclusive\")\n        raise SystemExit(1)\n    # --for only qualifies --show-excludes; reject it before a real backup runs.\n    if for_path and not show_excludes:\n        console.failure(\"--for requires --show-excludes\")\n        raise SystemExit(1)\n\n    cfg = _load_config(ctx)\n    if cfg is None:\n        return\n    if show_excludes:\n        failed = _show_excludes(cfg, show_excludes, for_path)\n        if failed:\n            raise SystemExit(1)\n        return\n\n    plan = applicable_instances(cfg)\n    plan, unknown_only = _select_plan(cfg, plan, only, tags)\n\n    if list_plan:\n        _list_instances(plan)\n        if unknown_only:\n            raise SystemExit(1)\n        return\n\n    plan = _override_selected(plan, source, out)\n    any_failed = _run_plan(cfg, plan, dry_run=dry_run, plan_only=plan_only, jobs=jobs)\n    # Unknown --only names must fail rather than silently omit backup work.\n    if any_failed or unknown_only:\n        raise SystemExit(1)\n\n\nif __name__ == \"__main__\":\n    cli()\n\nFalse\n","exit_code":0,"status":"completed"}}
