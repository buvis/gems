File\",\"content\":[{\"type\":\"content\",\"content\":{\"type\":\"text\",\"text\":\"<file name=\\\"docs/dev/project-management/autopilot/reports/00111-review-c1-stage-review-diff-00111-c1-20261031.diff\\\" language=\\\"plaintext\\\" >\\n<content>\\n+        finally:\\n+            with self.lock:\\n+                self.active -= 1\\n+\\n+    def blocked(self, kwargs: dict[str, Any]) -> Iterator[StepResult]:\\n+        name = kwargs[\\\"label\\\"]\\n+        assert self.release[name].wait(WAIT), f\\\"worker {name} was not released\\\"\\n+        yield StepResult(name, True, f\\\"complete {name}\\\")\\n+\\n+    def release_all(self) -> None:\\n+        for event in self.release.values():\\n+            event.set()\\n+\\n+\\n+def configure(monkeypatch: pytest.MonkeyPatch, probe: CapabilityProbe) -> BackupConfig:\\n+    monkeypatch.setitem(CAPABILITIES, \\\"parallel-probe\\\", probe)\\n+    instances = {\\n+        name: {\\n+            \\\"use\\\": \\\"parallel-probe\\\",\\n+            \\\"order\\\": ORDERS.get(name, 100),\\n+            \\\"exclude_add\\\": [f\\\"{name}-exclude\\\"],\\n+            \\\"with\\\": {\\\"source\\\": f\\\"/source/{name}\\\", \\\"out\\\": f\\\"/output/{name}.tgz\\\", \\\"token\\\": f\\\"token-{name}\\\"},\\n+        }\\n+        for name in probe.started\\n+    }\\n+    return BackupConfig.model_validate({\\\"instances\\\": instances, \\\"excludes\\\": [\\\"global-exclude\\\"]})\\n+\\n+\\n+class Consumption:\\n+    def __init__(self, runner: Runner, cfg: BackupConfig, probe: CapabilityProbe) -> None:\\n+        self.runner, self.cfg, self.probe = runner, cfg, probe\\n+        self.results: list[StepResult] = []\\n+        self.errors: list[BaseException] = []\\n+        self.received = {name: threading.Event() for name in probe.started}\\n+        self.thread_ids: list[int] = []\\n+        self.thread = threading.Thread(target=self.collect, daemon=True)\\n+\\n+    def collect(self) -> None:\\n+        try:\\n+            for result in self.runner.run(list(self.cfg.instances.items())):\\n+                self.results.append(result)\\n+                self.thread_ids.append(threading.get_ident())\\n+                self.received[result.label].set()\\n+        except BaseException as exc:\\n+            self.errors.append(exc)\\n+\\n+    def __enter__(self) -> Consumption:\\n+        self.thread.start()\\n+        return self\\n+\\n+    def finish(self) -> None:\\n+        self.thread.join(WAIT)\\n+        assert not self.thread.is_alive(), \\\"runner did not finish bounded cleanup\\\"\\n+        assert self.errors == []\\n+\\n+    def __exit__(self, *args: object) -> None:\\n+        self.probe.release_all()\\n+        self.thread.join(WAIT)\\n+        assert not self.thread.is_alive(), \\\"runner leaked its consumer or worker threads\\\"\\ndiff --git a/tests/tools/backup/test_backup_cli.py b/tests/tools/backup/test_backup_cli.py\\nindex 397247b2..2925f564 100644\\n--- a/tests/tools/backup/test_backup_cli.py\\n+++ b/tests/tools/backup/test_backup_cli.py\\n@@ -1,6 +1,7 @@\\n from __future__ import annotations\\n \\n import json\\n+from collections.abc import Generator\\n from pathlib import Path\\n from unittest.mock import patch\\n \\n@@ -10,6 +11,7 @@ from click.testing import CliRunner\\n \\n from backup.cli import cli\\n from backup.config import BackupConfig\\n+from backup.runner import Runner\\n from backup.step_result import StepResult\\n \\n \\n@@ -17,6 +19,10 @@ def _cfg(instances: dict[str, dict[str, object]]) -> BackupConfig:\\n     return BackupConfig.model_validate({\\\"instances\\\": instances})\\n \\n \\n+def _steps(*steps: StepResult) -> Generator[StepResult, None, None]:\\n+    yield from steps\\n+\\n+\\n class TestBackupCliShape:\\n     def test_cli_is_a_single_command_not_a_group(self) -> None:\\n         assert isinstance(cli, click.Command)\\n@@ -39,7 +45,7 @@ class TestBackupCliRun:\\n             patch(\\\"backup.config.applicable_instances\\\", return_value=[(\\\"git-src\\\", c