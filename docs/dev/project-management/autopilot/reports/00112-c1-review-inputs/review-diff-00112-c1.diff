rFile, name: str, *args: object, **kwargs: object) -> None:\\n227:            original_add(archive, name, *args, **kwargs)\\n228:            clock[0] = moments[Path(name).name]\\n229:\\n230:        monkeypatch.setattr(time, \\\"monotonic\\\", lambda: clock[0])\\n231:        monkeypatch.setattr(tarfile.TarFile, \\\"add\\\", add_with_clock)\\n232:        events: list[ProgressEvent] = []\\n233:        result = next(\\n234:            iter(\\n235:                TarArchive().run(\\n236:                    label=\\\"timed\\\",\\n237:                    source=str(source),\\n238:                    out=str(tmp_path / \\\"timed.tar.gz\\\"),\\n239:                    engine=\\\"python-tarfile\\\",\\n240:                    items=names,\\n241:                    progress=events.append,\\n242:                )\\n243:            )\\n244:        )\\n245:        assert result.success is True\\n246:        total = sum(sizes)\\n247:        assert events == [\\n248:            ProgressEvent(\\\"timed\\\", \\\"scanning\\\", None, None),\\n249:            ProgressEvent(\\\"timed\\\", \\\"archiving\\\", 0, total),\\n250:            ProgressEvent(\\\"timed\\\", \\\"archiving\\\", sum(sizes[:2]), total),\\n251:            ProgressEvent(\\\"timed\\\", \\\"archiving\\\", total, total),\\n252:            ProgressEvent(\\\"timed\\\", \\\"finalizing\\\", total, total),\\n253:        ]\\n254:\\n255:    @pytest.mark.parametrize(\\\"label,size\\\", [(\\\"first\\\", 7), (\\\"first-old\\\", 29)])\\n256:    def test_engine_short_archive_flushes_without_waiting_or_duplicate_final_count(\\n257:        self,\\n258:        tmp_path: Path,\\n259:        monkeypatch: pytest.MonkeyPatch,\\n260:        label: str,\\n261:        size: int,\\n262:    ) -> None:\\n263:        source = tmp_path / \\\"src\\\"\\n264:        source.mkdir()\\n265:        (source / \\\"payload\\\").write_bytes(b\\\"x\\\" * size)\\n266:        monkeypatch.setattr(time, \\\"monotonic\\\", lambda: 42.0)\\n267:        events: list[ProgressEvent] = []\\n268:        result = next(\\n269:            iter(\\n270:                TarArchive().run(\\n271:                    label=label,\\n272:                    source=str(source),\\n273:                    out=str(tmp_path / \\\"out.tar.gz\\\"),\\n274:                    engine=\\\"python-tarfile\\\",\\n275:                    progress=events.append,\\n276:                )\\n277:            )\\n278:        )\\n279:        assert result.success is True\\n280:        assert events == [\\n281:            ProgressEvent(label, \\\"scanning\\\", None, None),\\n282:            ProgressEvent(label, \\\"archiving\\\", 0, size),\\n283:            ProgressEvent(label, \\\"archiving\\\", size, size),\\n284:            ProgressEvent(label, \\\"finalizing\\\", size, size),\\n285:        ]\\n286:\\n287:    @pytest.mark.parametrize(\\\"engine\\\", [\\\"python-tarfile\\\", \\\"system-tar\\\"])\\n288:    @pytest.mark.parametrize(\\\"items\\\", [None, [\\\"a\\\", \\\"b\\\"]])\\n289:    def test_engine_direct_dry_run_never_calls_progress(\\n290:        self,\\n291:        tmp_path: Path,\\n292:        engine: str,\\n293:        items: list[str] | None,\\n294:    ) -> None:\\n295:        source = tmp_path / \\\"src\\\"\\n296:        source.mkdir()\\n297:        (source / \\\"a\\\").write_bytes(b\\\"first\\\")\\n298:        (source / \\\"b\\\").write_bytes(b\\\"second payload\\\")\\n299:        out = tmp_path / \\\"out.tar.gz\\\"\\n300:        events: list[ProgressEvent] = []\\n301:        selected: dict[str, object] = {} if items is None else {\\\"items\\\": items}\\n302:        result = next(\\n303:            iter(\\n304:                TarArchive().run(\\n305:                    label=\\\"preview\\\",\\n306:                    source=str(source),\\n307:                    out=str(out),\\n308:                    engine=engine,\\n309:                    **selected,\\n310:                    dry_run=True,\\n311:                    progress=events.append,\\n312:                )\\n313:            )\\n314:        )\\n315:        assert result.success is True\\n316:        assert events == []\\n317:        assert not out.exists()\\n318:\\n319:    @pytest.mark.parametrize(\\\"source_state\\\", [\\\"missing\\\", \\\"file\\\"])\\n320:    def test_engine_unwalkable_source_emits_no_fabricated_activity(\\n321:        self,\\n322:        tmp_path: Path,\\n323:        source_state: str,\\n324:    ) -> None:\\n325:        source = tmp_path / source_state\\n326:        if source_state == \\\"file\\\":\\n327:            source.write_bytes(b\\\"not a directory\\\")\\n328:        events: list[ProgressEvent] = []\\n329:        out = tmp_path / \\\"out.tar.gz\\\"\\n330:        result = next(\\n331:            iter(\\n332:                TarArchive().run(\\n333:                    label=\\\"unwalkable\\\",\\n334:                    source=str(source),\\n335:                    out=str(out),\\n336:                    engine=\\\"python-tarfile\\\",\\n337:                    progress=events.append,\\n338:                )\\n339:            )\\n340:        )\\n341:        assert result.success is (source_state == \\\"missing\\\")\\n342:        assert result.skipped is (source_state == \\\"missing\\\")\\n343:        assert events == []\\n344:        assert not out.exists()\\n345:\\n346:    def test_engine_selection_skip_can_end_after_scanning(self, tmp_path: Path) -> None:\\n347:        source = tmp_path / \\\"src\\\"\\n348:        source.mkdir()\\n349:        (source / \\\"a-old\\\").write_bytes(b\\\"near miss\\\")\\n350:        (source / \\\"b-old\\\").write_bytes(b\\\"another near miss\\\")\\n351:        events: list[ProgressEvent] = []\\n352:        out = tmp_path / \\\"out.tar.gz\\\"\\n353:        result = next(\\n354:            iter(\\n355:                TarArchive().run(\\n356:                    label=\\\"empty\\\",\\n357:                    source=str(source),\\n358:                    out=str(out),\\n359:                    items=[\\\"a\\\", \