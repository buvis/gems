ive.extractfile(member)\\n486:                assert extracted is not None\\n487:                assert extracted.read() == payloads[Path(member.name).name]\\n488:\\n489:    @pytest.mark.parametrize(\\\"sizes\\\", [[7, 19], [13, 31]])\\n490:    def test_input_bytes_counts_regular_paths_and_hardlinks_but_not_directories_or_symlinks(\\n491:        self,\\n492:        tmp_path: Path,\\n493:        sizes: list[int],\\n494:    ) -> None:\\n495:        source = tmp_path / \\\"src\\\"\\n496:        source.mkdir()\\n497:        first = source / \\\"a\\\"\\n498:        second = source / \\\"a-old\\\"\\n499:        first.write_bytes(b\\\"x\\\" * sizes[0])\\n500:        second.write_bytes(b\\\"y\\\" * sizes[1])\\n501:        hardlink = source / \\\"hardlink\\\"\\n502:        os.link(first, hardlink)\\n503:        directory = source / \\\"directory\\\"\\n504:        directory.mkdir()\\n505:        (directory / \\\"not-selected\\\").write_bytes(b\\\"must not recurse\\\")\\n506:        symlink = source / \\\"symlink\\\"\\n507:        symlink.symlink_to(second)\\n508:        broken = source / \\\"broken\\\"\\n509:        broken.symlink_to(source / \\\"absent\\\")\\n510:        counts: list[int] = []\\n511:        finalized: list[bool] = []\\n512:        out = tmp_path / \\\"out.tar.gz\\\"\\n513:        files = [first, directory, symlink, broken, second, hardlink]\\n514:        _write_archive(out, source, files, on_bytes=counts.append, on_finalize=lambda: finalized.append(True))\\n515:        assert counts == [sizes[0], sizes[0], sizes[0], sizes[0], sum(sizes), sum(sizes) + sizes[0]]\\n516:        assert finalized == [True]\\n517:        with tarfile.open(out) as archive:\\n518:            members = {Path(member.name).name: member for member in archive.getmembers()}\\n519:        assert set(members) == {path.name for path in files}\\n520:        assert members[\\\"symlink\\\"].issym()\\n521:        assert members[\\\"broken\\\"].issym()\\n522:        assert members[\\\"directory\\\"].isdir()\\n523:        assert members[\\\"hardlink\\\"].islnk()\\n524:\\n525:    def test_input_bytes_empty_writer_finalizes_without_member_callbacks(self, tmp_path: Path) -> None:\\n526:        counts: list[int] = []\\n527:        finalized: list[bool] = []\\n528:        out = tmp_path / \\\"empty.tar.gz\\\"\\n529:        _write_archive(out, tmp_path, [], on_bytes=counts.append, on_finalize=lambda: finalized.append(True))\\n530:        assert counts == []\\n531:        assert finalized == [True]\\n532:        with tarfile.open(out) as archive:\\n533:            assert archive.getmembers() == []\\n534:\\n535:    @pytest.mark.parametrize(\\\"size\\\", [7, 29])\\n536:    def test_input_bytes_failed_member_preserves_output_and_never_finalizes(\\n537:        self,\\n538:        tmp_path: Path,\\n539:        monkeypatch: pytest.MonkeyPatch,\\n540:        size: int,\\n541:    ) -> None:\\n542:        source = tmp_path / \\\"src\\\"\\n543:        source.mkdir()\\n544:        first = source / \\\"a\\\"\\n545:        first.write_bytes(b\\\"x\\\" * size)\\n546:        second = source / \\\"a-old\\\"\\n547:        second.write_bytes(b\\\"not successfully added\\\")\\n548:        out = tmp_path / \\\"out.tar.gz\\\"\\n549:        out.write_bytes(b\\\"previous archive\\\")\\n550:        counts: list[int] = []\\n551:        finalized: list[bool] = []\\n552:        original_add = tarfile.TarFile.add\\n553:\\n554:        def fail_second(archive: tarfile.TarFile, name: str, *args: object, **kwargs: object) -> None:\\n555:            if Path(name) == second:\\n556:                raise OSError(\\\"archive member failed\\\")\\n557:            original_add(archive, name, *args, **kwargs)\\n558:\\n559:        monkeypatch.setattr(tarfile.TarFile, \\\"add\\\", fail_second)\\n560:        with pytest.raises(OSError, match=\\\"archive member failed\\\"):\\n561:            _write_archive(\\n562:                out,\\n563:                source,\\n564:                [first, second],\\n565:                on_bytes=counts.append,\\n566:                on_finalize=lambda: finalized.append(True),\\n567:            )\\n568:        assert counts == [size]\\n569:        assert finalized == []\\n570:        assert out.read_bytes() == b\\\"previous archive\\\"\\n571:        assert sorted(path.name for path in tmp_path.iterdir()) == [\\\"out.tar.gz\\\", \\\"src\\\"]\\n572:\\n573:    def test_input_bytes_state_is_local_to_each_shared_capability_run(\\n574:        self,\\n575:        tmp_path: Path,\\n576:        monkeypatch: pytest.MonkeyPatch,\\n577:    ) -> None:\\n578:        capability = TarArchive()\\n579:        monkeypatch.setattr(time, \\\"monotonic\\\", lambda: 42.0)\\n580:        for label, size in [(\\\"a\\\", 7), (\\\"a-old\\\", 23)]:\\n581:            source = tmp_path / label\\n582:            source.mkdir()\\n583:            (source / \\\"data\\\").write_bytes(b\\\"x\\\" * size)\\n584:            events: list[ProgressEvent] = []\\n585:            result = next(\\n586:                iter(\\n587:                    capability.run(\\n588:                        label=label,\\n589:                        source=str(source),\\n590:                        out=str(tmp_path / f\\\"{label}.tar.gz\\\"),\\n591:                        engine=\\\"python-tarfile\\\",\\n592:                        progress=events.append,\\n593:                    )\\n594:                )\\n595:            )\\n596:            assert result.success is True\\n597:            assert events[-2:] == [\\n598:                ProgressEvent(label, \\\"archiving\\\", size, size),\\n599:                ProgressEvent(label, \\\"finalizing\\\", size, size),\\n600:            ]\\n601:\\n602:\\n603:class TestProgressExceptionsSwallowed:\\n604:    @pytest.mark.parametrize(\\n605:        \\\"exception\\\",\\n606:        [\\n607:            ValueError(\\\"first\\\"),\\n608:            RuntimeError(\\\"first-old\\\"),\\n609:            OSError(\\\"unavailable\\\"),\\n610:            TypeError(\\\"