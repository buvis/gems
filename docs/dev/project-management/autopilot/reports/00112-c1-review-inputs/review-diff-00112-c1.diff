members) == 1\\n404:            assert Path(members[0].name).name == \\\"payload\\\"\\n405:            extracted = archive.extractfile(members[0])\\n406:            assert extracted is not None\\n407:            assert extracted.read() == payload\\n408:\\n409:    @pytest.mark.parametrize(\\\"engine\\\", [\\\"python-tarfile\\\", \\\"system-tar\\\"])\\n410:    def test_engine_empty_source_reports_zero_total_and_finalizes_real_archive(\\n411:        self,\\n412:        tmp_path: Path,\\n413:        engine: str,\\n414:    ) -> None:\\n415:        source = tmp_path / \\\"empty\\\"\\n416:        source.mkdir()\\n417:        out = tmp_path / \\\"empty.tar.gz\\\"\\n418:        events: list[ProgressEvent] = []\\n419:        result = next(\\n420:            iter(\\n421:                TarArchive().run(\\n422:                    label=\\\"empty\\\",\\n423:                    source=str(source),\\n424:                    out=str(out),\\n425:                    engine=engine,\\n426:                    progress=events.append,\\n427:                )\\n428:            )\\n429:        )\\n430:        assert result.success is True\\n431:        assert result.out_path == str(out)\\n432:        done = 0 if engine == \\\"python-tarfile\\\" else None\\n433:        assert events == [\\n434:            ProgressEvent(\\\"empty\\\", \\\"scanning\\\", None, None),\\n435:            ProgressEvent(\\\"empty\\\", \\\"archiving\\\", done, 0),\\n436:            ProgressEvent(\\\"empty\\\", \\\"finalizing\\\", done, 0),\\n437:        ]\\n438:        with tarfile.open(out) as archive:\\n439:            assert not any(member.isfile() for member in archive.getmembers())\\n440:\\n441:\\n442:class TestArchiveInputBytes:\\n443:    @pytest.mark.parametrize(\\\"fixture_kind\\\", [\\\"incompressible\\\", \\\"compressible\\\"])\\n444:    def test_percent_uses_input_bytes_not_output_size(self, tmp_path: Path, fixture_kind: str) -> None:\\n445:        source = tmp_path / \\\"src\\\"\\n446:        source.mkdir