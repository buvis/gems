ch, capability, (\\\"docs\\\", \\\"docs-old\\\"))\\n325:        runner = Runner(\\n326:            cfg,\\n327:            on_progress=events.append,\\n328:            on_tick=lambda: ticks.append(1),\\n329:        )\\n330:        assert {entry.label for entry in runner.plan(list(cfg.instances.items()))} == {\\\"docs\\\", \\\"docs-old\\\"}\\n331:        assert capability.calls == []\\n332:        assert len(capability.plans) == 2\\n333:        empty = Runner(BackupConfig(), on_progress=events.append, on_tick=lambda: ticks.append(1))\\n334:        assert list(empty.run([])) == []\\n335:        assert list(empty.plan([])) == []\\n336:        assert events == []\\n337:        assert ticks == []\\n338:\\n339:    def test_runner_unknown_capability_yields_failure_without_fabricated_progress(\\n340:        self,\\n341:        monkeypatch: pytest.MonkeyPatch,\\n342:    ) -> None:\\n343:        events: list[ProgressEvent] = []\\n344:\\n345:        def produce(kwargs: dict[str, Any]) -> Iterator[StepResult]:\\n346:            for event in _frames(kwargs[\\\"label\\\"]):\\n347:                kwargs[\\\"progress\\\"](event)\\n348:            yield StepResult(kwargs[\\\"label\\\"], True, \\\"stored\\\")\\n349:\\n350:        capability = _Capability(produce)\\n351:        cfg = _config(monkeypatch, capability, (\\\"docs\\\",))\\n352:        cfg = BackupConfig(instances={**cfg.instances, \\\"docs-old\\\": BackupInstance(use=\\\"controlled-progress-old\\\")})\\n353:        runner = Runner(cfg, on_progress=events.append)\\n354:        results = {}\\n355:        for result in runner.run(list(cfg.instances.items())):\\n356:            results[result.label] = result\\n357:            if result.label == \\\"docs\\\":\\n358:                assert events == _frames(\\\"docs\\\")\\n359:        assert results[\\\"docs\\\"].success is True\\n360:        assert results[\\\"docs-old\\\"].success is False\\n361:        assert results[\\\"docs-old\\\"].message\\n362:        assert events == _frames(\\\"docs\\\")\\n363:        assert [call[\\\"label\\\"] for call in capability.calls] == [\\\"docs\\\"]\\n364:\\n365:\\n366:class TestRunnerCancellation:\\n367:    @pytest.mark.parametrize(\\\"interrupt\\\", [False, True])\\n368:    def test_runner_drains_queued_prefix_when_observer_requests_cancel_or_interrupts(\\n369:        self,\\n370:        monkeypatch: pytest.MonkeyPatch,\\n371:        interrupt: bool,\\n372:    ) -> None:\\n373:        queued = threading.Event()\\n374:        finished = threading.Event()\\n375:        received: list[ProgressEvent] = []\\n376:\\n377:        def produce(kwargs: dict[str, Any]) -> Iterator[StepResult]:\\n378:            try:\\n379:                for event in _frames(kwargs[\\\"label\\\"])[:2]:\\n380:                    kwargs[\\\"progress\\\"](event)\\n381:                queued.set()\\n382:                assert kwargs[\\\"cancel\\\"].wait(3), \\\"cancellation did not reach capability\\\"\\n383:                kwargs[\\\"progress\\\"](_frames(kwargs[\\\"label\\\"])[2])\\n384:                yield StepResult(kwargs[\\\"label\\\"], False, \\\"cancelled writer\\\")\\n385:            finally:\\n386:                finished.set()\\n387:\\n388:        def observe(event: ProgressEvent) -> None:\\n389:            received.append(event)\\n390:            if len(received) == 1:\\n391:                assert queued.wait(2)\\n392:                if interrupt:\\n393:                    raise Key…3286 tokens truncated…ternal**: pybase + zettel not published separately\\n645:- **All-interface rule**: every command/action must work across CLI, TUI, API, and WebUI\\n646:\\n647:## Tool Structure\\n648:\\n649:Every tool under `src/tools/<name>/` follows a base layout:\\n650:\\n651:```text\\n652:tool_name/\\n653:├── __init__.py\\n654:├── __main__.py\\n655:├── cli.py              # Click entry point\\n656:├── settings.py         # Tool-specific settings\\n657:└── commands/           # One module per CLI command\\n658:```\\n659:\\n660:Add subdirs only when needed:\\n661:\\n662:| Dir | When | Example |\\n663:|-----|------|---------|\\n664:| `adapters/` | External service clients | fctracker, readerctl |\\n665:| `domain/` | Business logic beyond simple commands | fctracker |\\n666:| `shared/` | Code reused across commands | zseq |\\n667:\\n668:> `bim/commands/serve/frontend/` contains the WebUI SvelteKit app — the only tool with a frontend subtree.\\n669:\\n670:> `bim/commands/doc/` follows the existing `commands/serve/`-style group pattern with a `shared/` subdir holding cross-command utilities (pipeline, OCR/classifier/extractor adapters, state DB, issuer registry, zettel writer).\\n671:\\n672:## Code Conventions\\n673:\\n674:**Type hints** — modern style, no `Optional`:\\n675:\\n676:```python\\n677:from __future__ import annotations\\n678:def foo(path: Path | None = None) -> list[str]: ...\\n679:```\\n680:\\n681:**Imports**:\\n682:\\n683:- Explicit `__all__` in `__init__.py`\\n684:- `TYPE_CHECKING` guards for type-only imports\\n685:\\n686:**Docstrings**: Google format\\n687:\\n688:**CLI pattern**: Click-based. `buvis_options` adds `--version`, `--config`, `--log-level`, `--debug`, and `--update` to every tool automatically:\\n689:\\n690:```python\\n691:@click.command()\\n692:@buvis_options\\n693:@click.pass_context\\n694:def cli(ctx: click.Context) -> None:\\n695:    settings = get_settings(ctx)\\n696:    ...\\n697:```\\n698:\\n699:**Lazy imports in CLI handlers**: import command classes inside handler functions, not at module level. This avoids pulling in optional/heavy dependencies before the user picks a subcommand:\\n700:\\n701:```python\\n702:@cli.command(\\\"create\\\")\\n703:@click.pass_context\\n704:def create(ctx):\\n705:    from bim.commands.create_note.create_note import CommandCreateNote\\n706:    ...\\n707:```\\n708:\\n709:## Error Handling\\n710:\\n711:**Command layer** (`commands/`):\\n712:- Return `CommandResult` for all outcomes — success and failure\\n713:- Catch expected exceptions (e.g. `FileNotFoundError`) internally, return `CommandResult(success=False, error=str(exc))`\\n714:- No `console.panic()` or `sys.exit()` inside command classes\\n715:- No custom exception classes for control flow\\n716:\\n717:**CLI layer** (`cli.py`):\\n718:- Inspect `CommandResult` and call `console.panic()` / `console.failure()` / `console.success()`\\n719:- Use `console.report_result()` for standardized output\\n720:- Catch `ImportError` for optional deps, call `console.require_import()`\\n721:- Catch `FatalError` for unrecoverable infrastructure failures\\n722:\\n723:**Click argument validation**:\\n724:- Avoid parse-time validators that short-circuit before the callback (`click.Path(exists=True)`, `IntRange`, custom `ParamType.convert` that raises). They emit Click's default `Usage: ... Error: ...` formatting and bypass the buvis console.\\n725:- Validate inside the callback instead: `if not path.is_file(): console.panic(f\\\"file not found: {path}\\\"); return`.\\n726:- `click.Choice` is the exception — its parse-time error lists the valid values, which is more useful than a rewritten message.\\n727:\\n728:**Console methods**:\\n729:- Fatal (exit): `console.panic(msg)` — prints + exits with code 1\\n730:- Recoverable: `console.failure(msg)` — prints, continues\\n731:- Status: `console.success()`, `console.warning()`, `console.info()`\\n732:- All user-facing output must route through `console`. No `print()`, `sys.stdout.write()`, `sys.stderr.write()`, `click.echo()`, `click.secho()`, or the Python logging module. Plain writes bypass the buvis prefix markers (`✘`, `✓`, etc.) and become indistinguishable from stray output, which is what makes a missed `console.panic` look like a print statement to the user.\\n733:- The one sanctioned exception is the `dot filter` clean/smudge plumbing, which writes git's blob payload as raw bytes on stdout and at most one error line on stderr, because git owns both streams and a console marker would corrupt the payload (discovery R12).\\n734:- Never let raw exceptions (stack traces) reach the user.\\n735:\\n736:## Invariants (evolution guardrails)\\n737:\\n738:These encode the failure classes surfaced by the 2026-07-09 evolution assessment (`docs/dev/project-management/reviews/evolution-assessment-2026-07-09.md`). Each is either **HOLDS** (enforce it) or a **GAP** (a tracked PRD is closing it — write new code to the target state, not the current one).\\n739:\\n740:- **Atomic persistence** — never persist a note, state file, or config with a bare `Path.write_text`/`open(...,\\\"w\\\")`. Use `pybase.filesystem.atomic_write` (tempfile + fsync + `os.replace`). Truncate-then-write loses data on crash/ENOSPC. *HOLDS for the library and note/updater write paths (00041) — keep it, except `ConfigWriter.write` (`configuration/config_writer.py`), which still does a bare `write_text` — deliberately out of scope for 00041. GAP → pidash was closed by retiring pidash (00071); autopilot-state durability now lives in the buvis home repo (tracon/statectl), not gems.*\\n741:- **Confine request-derived paths** — any filesystem path built from an HTTP request / external input must be `resolve()`d and asserted under an allowed root before read/write/delete/open. Network-facing servers must have auth + `TrustedHostMiddleware`. *HOLDS (00042) — bim serve confines request paths via `confine_path` (403 outside the vault/archive roots), mints a startup token required as `X-Buvis-Token`, installs `TrustedHostMiddleware`, and warns on a non-loopback bind (`commands/serve/_security.py`). Keep it.*\\n742:- **The library stays interface-agnostic** — `src/lib/buvis/pybase/` must not import a UI framework at module import time or emit output outside the console adapter. No import-time Click monkey-patching, no `sys.exit`/`click.echo`/`print` in lib code. A TUI/API/WebUI process must be able to `import` settings without pulling Click. *HOLDS (00052) — keep it.*\\n743:- **One action, one implementation across interfaces** — CLI/TUI/API/WebUI adapters must drive the same command class / use case through the composition root and return `CommandResult`; do not reimplement business logic per interface (dot's TUI is the anti-pattern; bim's serve action registry is the exemplar). *HOLDS (00051 design → 00053/00054) — the all-interface seam design (00051) is realized: dot's git ops unified behind `DotGitService` (00053) and bim's serve/TUI converged on the shared action registry (00054). Keep it.*\\n744:- **Claim/lifecycle release on any exit** — resource claims and locks release in `finally` (or catch `BaseException`), never only `except Exception`; `KeyboardInterrupt` must not leak a claim. *HOLDS (00044) — the bim doc claim/dedup pipeline releases claims and locks in `finally` (`commands/doc/shared/`); keep it.*\\n745:- **`CommandResult` discipline** — commands return `CommandResult`; the CLI/adapter layer renders it (`console.report_result`) and maps exit/HTTP status. No `sys.exit`/`console.panic` inside command classes. *HOLDS in `src/tools/*/commands/**` — keep it.*\\n746:- **Clean-architecture layering + tool isolation** — zettel `domain → application → infrastructure → integrations` one-directional; no cross-tool imports; no `src/lib → src/tools`. *HOLDS — keep it.*\\n747:\\n748:## Testing\\n749:\\n750:- pytest + pytest-mock + pytest-cov\\n751:- Tests in `tests/` mirror `src/lib/` and `src/tools/` structure\\n752:- Mock subprocess calls heavily\\n753:- Class-based test organization\\n754:- **No unused imports/variables**\\n755:- **Markers**: `pytest -m <tool>` runs one tool, `pytest -m lib` runs library tests, `pytest -m \\\"not bim\\\"` excludes a tool. Auto-applied by path in `tests/conftest.py` — no decorators needed. Scaffold registers markers for new tools.\\n756:- **Snapshot tests** (`@pytest.mark.snapshot`) only run on the canonical env (Linux + Python 3.12) — SVG output from Rich/Textual differs across OS/Python so baselines must come from one place. Anywhere else they are auto-skipped. To regenerate baselines run the `update-snapshots` GitHub workflow (`gh workflow run update-snapshots.yml`); it runs `pytest --snapshot-update` on the canonical env and commits the result. Force locally with `BUVIS_SNAPSHOT_CANONICAL=1` only if you know what you're doing.\\n757:\\n758:## Installation\\n759:\\n760:```bash\\n761:uv tool install buvis-gems              # core only (no tool-specific deps)\\n762:uv tool install buvis-gems[bim]         # with jira support\\n763:uv tool install buvis-gems[bim-web]     # bim web UI deps\\n764:uv tool install buvis-gems[all]         # everything\\n765:uv tool upgrade buvis-gems              # update\\n766:```\\n767:\\n768:Extras: `bim`, `bim-web`, `doc`, `dot`, `fren`, `morph`, `muc`, `pinger`, `postup`, `postup-web`, `readerctl`, `all`\\n769:\\n770:## Release\\n771:\\n772:> Full procedure (version authority, checks, destinations, partial-failure recovery): `docs/dev/procedures/releasing.md`.\\n773:\\n774:```bash\\n775:release patch|minor|major              # bump, tag, push → CI publishes to PyPI\\n776:release --pre rc1                      # pre-release current version to TestPyPI\\n777:release --pre rc1 minor                # bump + pre-release to TestPyPI\\n778:release                                # after rc: strip suffix, release stable to PyPI\\n779:release local                          # build .devN wheel + install locally\\n780:release --dry-run [--pre rc1] [patch]  # preview without changes\\n781:```\\n782:\\n783:`mise` adds `tools` to PATH (shims; `tools/lib` holds the implementations). Tags with `rc` in the name publish to TestPyPI; stable tags go to PyPI. Manual workflow dispatch defaults to TestPyPI.\\n784:\\n785:**First-time setup** (already done for buvis-gems):\\n786:- test.pypi.org: add trusted publisher (owner: `buvis`, repo: `gems`, workflow: `publish.yml`, env: `testpypi`)\\n787:- GitHub repo settings: create `testpypi` and `pypi` environments\\n788:\\n789:**Why explicit version in pyproject.toml?** maturin reads the version from `pyproject.toml` at build time to compile the Rust extension. Tag-based versioning (hatch-vcs) would require glue to inject the version before maturin sees it. Pure Python projects like mkdocs-zettelkasten use hatch-vcs instead — the version derives from the git tag, no file to keep in sync, no bump commits.\\n790:\\n791:Relevant reviewed API contracts (not acceptance criteria):\\n792:\\n793:```python\\n794:def Runner.__init__(\\n795:    self: Runner, cfg: BackupConfig, *, dry_run: bool = False, jobs: int = 3,\\n796:    on_progress: Callable[[ProgressEvent], None] | None = None,\\n797:    on_tick: Callable[[], None] | None = None,\\n798:) -> None: ...\\n799:```\\n800:\\n801:Keep `Runner.run`, `request_cancel`, `plan`, `interrupted` and `cancelled_names` contracts unchanged. `on_tick` is an optional, backward-compatible refinement of the PRD's wake-up requirement: a wake-up with no event needs a distinct hook to recompute elapsed text. Never replay an old `ProgressEvent`, synthesize a heartbeat phase, yield non-results or create a CLI timer thread to implement a tick.\\n802:\\n803:Each `run()` creates a fresh `queue.Queue[ProgressEvent](maxsize=256)` for progress, separate from the existing completed-future queue. The progress queue holds at most 256 events. Workers receive only the enqueue callable as `progress`; they never receive `on_progress`, `on_tick` or a console object. The enqueue callable checks the run's cancellation event, then calls `put(event, timeout=0.2)`; on `queue.Full`, retry while cancellation remains unset. If cancellation becomes set, return without enqueueing or raising. A queue timeout is backpressure, never an archive failure. No event is silently dropped for an uncancelled successful instance. When `on_progress is None` or `dry_run=True`, pass `progress=None` instead. No callbacks are invoked by `plan()`. Suppress both callbacks for dry runs.\\n804:\\n805:While work remains pending, drain currently queued progress with `get_nowait()` before waiting for a completion, then use `completed.get(timeout=0.2)`. Catch `queue.Empty` as a normal wake-up, drain progress again, and invoke the optional tick on the iteration thread. Drain on completion notification as well. Drain before every terminal result is yielded, including ready preflight rows and cancellation outcomes, and once after joined workers finish during normal cancellation. These drains unblock bounded-queue producers even when no future has completed. Enqueuing is synchronous inside the capability, before its future completes, so a completed uncancelled instance's entire queued progress prefix is available before its result. Preserve FIFO event order per label. Cross-label event order is queue insertion order and need not equal configured launch order. After cancellation, no new progress enqueue is required; drain every event already queued before terminal cancellation results.\\n806:\\n807:Ticks run on the thread advancing `Runner.run`, only while the generator is actively executing. The wait loop offers a tick at least every 0.2 seconds during an otherwise idle wait, subject to scheduler/callback execution time; no guarantee applies while the consumer holds a yielded result or the existing blocking cancellation join runs. A callback must be short and nonblocking. Catch ordinary exceptions from each `on_progress`/`on_tick` invocation separately so one broken observer cannot turn any archive into a failure. Preserve calling-thread `KeyboardInterrupt` handling, request cancellation and drain the same run.\\n808:\\n809:On generator abandonment, set cancellation before joining writers, so producers blocked on the bounded queue observe cancellation after at most their current 0.2-second put timeout and return. Do not invoke user callbacks from the abandonment-only `finally` path. Normal cancellation likewise sets cancellation before shutdown/join, then drains the joined queue before yielding results. Release per-run queue references on exit. A subsequent run uses clean queues and cannot receive earlier events. Do not refactor outcomes, submission boundaries, lost-notification recovery or cancellation ordering as part of this feature.\\n810:Read-only support modules: /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/step_result.py, /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/config.py, /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/capabilities/__init__.py, /Users/bob/git/src/github.com/buvis/gems/src/tools/backup/runner.py\\n811:Existing regression seam: test_runner_interrupt_boundaries.py and test_parallel_runner.py monkeypatch backup.runner.queue.Queue to inject completion-wait interruptions. Preserve that completion queue seam when adding a separate bounded progress queue; use separate construction ownership if necessary. Do not edit those tests. Existing _run_instance callers may omit any new private optional progress argument. Read Runner._execute near81 and _run_instance near189 first. Keep timed waits, bounded enqueue cancellation and cleanup semantics explicit; isolate observer exceptions. New mandatory callback/context arguments may need narrowly justified PLR0913 noqa rather than changing public signature contracts.\\n812:\\n813:Use Python patterns at /Users/bob/.agents/skills/python-patterns/SKILL.md for Python edits. Keep modified functions under50 lines and Python files under800 lines, preserving behavior; small helpers within allowlisted source are permitted. Existing task tests are read-only. Add a focused Added CHANGELOG entry under Unreleased for this task; it is mandatory in each feature commit. Do not commit; coordinator handles commits. Native implementation route OpenAI gpt-6.1-sol/high, logical opus; independent completion review route Anthropic Opus/xhigh is supported by autocodex driver.\\n814:\\n815:\\n816:## Files you may read and modify\\n817:\\n818:/Users/bob/git/src/github.com/buvis/gems/src/tools/backup/runner.py\\n819:/Users/bob/git/src/github.com/buvis/gems/CHANGELOG.md\\n820:\\n821:Read only the files listed above. If a file or symbol you need is not\\n822:listed, stop and report it as a blocker — do not run broad `rg` sweeps to\\n823:discover scope.\\n824:\\n825:Fix only the listed Ruff findings, preserving passing behavior and previous automatic Ruff fixes.\\n826:\\n827:### Code quality rules (mandatory)\\n828:\\n829:Follow these four rules. They override any instinct to \\\"improve\\\" the code\\n830:beyond what the failing tests require.\\n831:\\n832:**1. Think before coding.** Re-read the task and the failing tests. If scope,\\n833:data shape, target file, or success criteria are ambiguous - more than one\\n834:reasonable implementation would pass the tests differently - STOP and report\\n835:the ambiguity as a blocker. Do not guess and proceed.\\n836:\\n837:**2. Simplicity.** Write the simplest code that makes the failing tests pass.\\n838:\\n839:- No abstractions, helpers, or interfaces built for a single caller.\\n840:- No error handling, fallbacks, or validation for inputs the tests never\\n841:  exercise. Validate at real system boundaries only.\\n842:- No features, options, or configuration the task did not ask for.\\n843:- If your draft runs long and the same behavior fits in far fewer lines,\\n844:  rewrite it before returning.\\n845:\\n846:**3. Surgical changes.** Touch only what the task requires.\\n847:\\n848:- Do not refactor, reformat, or \\\"improve\\\" code outside the change.\\n849:- Match the surrounding style even if you would write it differently.\\n850:- Remove imports, variables, and functions that YOUR change orphaned. Do not\\n851:  delete pre-existing dead code - mention it instead.\\n852:- Every changed line must trace to the task or a failing test.\\n853:\\n854:**4. Goal-driven.** The failing tests are the spec. Make them pass - do not\\n855:modify them, do not weaken them, do not add tests. If a test looks wrong,\\n856:report it as a blocker rather than changing it.\\n857:\\n858:Abort and report if you read more than 100K of total input. Return the\\n859:partial result and an abort_reason: context_overrun field.\\n860:\\n861:Read every file before your first Edit to it. Never call bash `head`,\\n862:`tail`, `cat`, `grep`, or `find` - a hook blocks them. Use the Read tool\\n863:(offset/limit), `rg`, or `rg --files` instead. Never combine an inspection\\n864:(read, list, search, diff) with a test, lint or build invocation in one Bash\\n865:call - run them as two calls, because a combined command has two ways to hang\\n866:and one exit code. Pass an explicit `timeout` on every Bash call: 60000 ms for\\n867:an inspection, 300000 ms for a lint run or a narrow test run, 600000 ms for a\\n868:full suite or a full build.\\n869:\\n870:Run only the test files this task names (the tests you wrote, or the\\n871:failing tests in your prompt), with `-q --tb=line`. Never run a whole test\\n872:directory or `dev/bin/release-checks`: the orchestrator runs the full suite\\n873:once, after every task. Read the pass count and exit code from that one\\n874:run; never re-run a suite to recover a number.\\n875:\\n876:End your report with `ASSUMPTIONS:` - one line per assumption you made\\n877:where the task, tests, or listed files were silent (guessed interface, data\\n878:shape, resolved ambiguity, unstated behavior). Write `ASSUMPTIONS: none` if\\n879:you made none.\\n880:\\n881:Also end your report with `FILES_TOUCHED:` - one line per file you created\\n882:or modified, path relative to the repo root. Write `FILES_TOUCHED: none` if\\n883:you changed no files.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19900-af9f-7d60-ae69-d05d6ac761a7","create_time":1793568332.159878}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
