    ProgressEvent(*args)\n77:\n78:    def test_event_record_distinguishes_similar_labels_and_each_field(self) -> None:\n79:        event = ProgressEvent(\"documents\", \"archiving\", 37, 101)\n80:        assert event != ProgressEvent(\"documents-old\", \"archiving\", 37, 101)\n81:        assert event != ProgressEvent(\"documents\", \"finalizing\", 37, 101)\n82:        assert event != ProgressEvent(\"documents\", \"archiving\", 38, 101)\n83:        assert event != ProgressEvent(\"documents\", \"archiving\", 37, 102)\n84:\n85:    def test_event_record_crosses_worker_thread_without_sharing_mutable_call_state(self) -> None:\n86:        original = ProgressEvent(\"documents\", \"scanning\", None, None)\n87:\n88:        def update_in_worker(event: ProgressEvent) -> tuple[ProgressEvent, ProgressEvent]:\n89:            updated = event._replace(phase=\"archiving\", done_bytes=37, total_bytes=101)\n90:            other = ProgressEvent(\"photos\", \"finalizing\", 0, 0)\n91:            return updated, other\n92:\n93:        with ThreadPoolExecutor(max_workers=1) as executor:\n94:            updated, other = executor.submit(update_in_worker, original).result(timeout=5)\n95:        assert tuple(original) == (\"documents\", \"scanning\", None, None)\n96:        assert (\n97:            original.label, original.phase, original.done_bytes, original.total_bytes\n98:        ) == (\"documents\", \"scanning\", None, None)\n99:        assert (other.label, other.phase, other.done_bytes, other.total_bytes) == (\n100:            \"photos\", \"finalizing\", 0, 0\n101:        )\n102:        assert isinstance(updated, ProgressEvent)\n103:        assert tuple(updated) == (\"documents\", \"archiving\", 37, 101)\n104:        replacements = [\n105:            (original._replace(label=\"photos\"), (\"photos\", \"scanning\", None, None)),\n106:            (original._replace(phase=\"finalizing\"), (\"documents\", \"finalizing\", None, None)),\n107:            (original._replace(done_bytes=37), (\"docu