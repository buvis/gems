+    @pytest.mark.parametrize("size", [7, 29])
+    def test_input_bytes_failed_member_preserves_output_and_never_finalizes(
+        self,
+        tmp_path: Path,
+        monkeypatch: pytest.MonkeyPatch,
+        size: int,
+    ) -> None:
+        source = tmp_path / "src"
+        source.mkdir()
