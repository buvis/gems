+    @pytest.mark.parametrize("sizes", [[7, 19], [13, 31]])
+    def test_input_bytes_counts_regular_paths_and_hardlinks_but_not_directories_or_symlinks(
+        self,
+        tmp_path: Path,
+        sizes: list[int],
+    ) -> None:
+        source = tmp_path / "src"
