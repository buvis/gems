+{"type":"thread.started","thread_id":"01a18c29-2322-7533-8684-ba1b9932872b"}
+{"type":"item.completed","item":{"id":"item_0","type":"error","message":"clamping SessionEnd hook timeout to 3s in /Users/bob/.codex/hooks.json"}}
